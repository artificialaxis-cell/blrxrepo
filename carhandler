local function getContactPoint(tire, origin, rayLength, raycastParams)
	local cframe = tire.CFrame
	local right = cframe.RightVector
	local forward = cframe.LookVector
	local direction = -cframe.UpVector * rayLength

	local hitPoints = {}
	local normals = {}
	local materialCounts = {}
	local hitCount = 0

	local function cast(rayOrigin)
		local result = workspace:Raycast(rayOrigin, direction, raycastParams)
		if result then
			hitCount += 1
			hitPoints[hitCount] = result.Position
			normals[hitCount] = result.Normal
			materialCounts[result.Material] = (materialCounts[result.Material] or 0) + 1
		end
	end

	cast(origin)
	for _, offset in ipairs(SAMPLE_OFFSETS) do
		cast(origin + right * offset[1] + forward * offset[2])
	end

	if hitCount == 0 then
		return nil
	end

	local highestY = -math.huge
	for i = 1, hitCount do
		highestY = math.max(highestY, hitPoints[i].Y)
	end

	local positionSum = Vector3.zero
	local normalSum = Vector3.zero
	local keptCount = 0

	for i = 1, hitCount do
		if highestY - hitPoints[i].Y <= 0.05 then
			positionSum += hitPoints[i]
			normalSum += normals[i]
			keptCount += 1
		end
	end

	local averageNormal = if normalSum.Magnitude > 1e-6 then normalSum.Unit else Vector3.yAxis

	local commonMaterial
	local highestCount = 0
	for material, count in pairs(materialCounts) do
		if count > highestCount then
			commonMaterial = material
			highestCount = count
		end
	end

	return positionSum / keptCount, averageNormal, commonMaterial
end

