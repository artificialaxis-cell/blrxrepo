			area = 2.25,
			rolling_resistance = 0.6
		},
	}

	engineRPM = stats.engine.idlerpm
	local transmission = stats.transmission
	local engineConfig = stats.engine

	local function track(connection)
		table.insert(connections, connection)
		return connection
	end

	local function tweenValue(value, target, duration)
		local previous = activeTweens[value]
		if previous then
			previous:Cancel()
		end

		local tween = TweenService:Create(value, TweenInfo.new(duration), { Value = target })
		activeTweens[value] = tween
		tween:Play()
	end

	local function releaseControls(parked)
		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		throttleValue.Value = 0
		clutchValue.Value = 0
		brakeValue.Value = if parked then 1 else 0
	end

	local function computeExitCFrame()
		if not (car:IsDescendantOf(workspace) and mass:IsDescendantOf(car)) then
			return entryCFrame
		end

		local massCFrame = mass.CFrame

		local side = -1
		if driverMass then
			side = if massCFrame:PointToObjectSpace(driverMass.Position).X < 0 then -1 else 1
		end

		local halfWidth = car:GetExtentsSize().X * 0.5
		local rightVector = flatten(massCFrame.RightVector, Vector3.xAxis)
		local lookVector = flatten(massCFrame.LookVector, -Vector3.zAxis)

		local position = massCFrame.Position
			+ rightVector * side * (halfWidth + CONFIG.ExitSideClearance)
			+ Vector3.yAxis * CONFIG.ExitHeight

		return CFrame.lookAt(position, position + lookVector)
	end

	local function leaveCar()
		if not driving then
			return
		end
		driving = false

		local exitCFrame = computeExitCFrame()

		releaseControls(true)

		if diedConnection then
			diedConnection:Disconnect()
			diedConnection = nil
		end

		local subject = if humanoid and humanoid.Parent then humanoid else nil
		local camera = workspace.CurrentCamera
		if camera and subject then
			camera.CameraSubject = subject
		end

		if rootPart and rootPart.Parent then
			rootPart.Anchored = false
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
			rootPart.CFrame = exitCFrame
		end

		character = nil
		humanoid = nil
		rootPart = nil

		if alive and prompt.Parent then
			prompt.Enabled = true
		end
	end

	local function hideCharacter(root)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = CONFIG.HiddenCFrame

		task.delay(CONFIG.HideAnchorDelay, function()
			if driving and rootPart == root and root.Parent then
				root.Anchored = true
			end
		end)
	end

	local function enterCar()
		if driving or not alive then
			return
		end

		local currentCharacter = player.Character
		local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
		local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")

		if not currentHumanoid or not currentRoot or currentHumanoid.Health <= 0 then
			return
		end

		driving = true
		enteredAt = os.clock()
		character = currentCharacter
		humanoid = currentHumanoid
		rootPart = currentRoot
		entryCFrame = currentRoot.CFrame

		prompt.Enabled = false
		releaseControls(false)

		hideCharacter(currentRoot)

		local camera = workspace.CurrentCamera
		if camera then
			camera.CameraSubject = primary
		end

		diedConnection = currentHumanoid.Died:Connect(leaveCar)
	end

	local function shiftGear(direction)
		if clutchValue.Value <= 0.67 then
			return
		end

		task.wait(stats.transmission.shift_time)

		if not alive or not driving then
			return
		end

		local newGear = gear + direction
		if newGear > -2 and newGear < #stats.transmission.gears - 1 then
			gear = newGear
		end
	end

	local function isCarIntact()
		return car:IsDescendantOf(workspace) and mass.Parent ~= nil and primary.Parent ~= nil
	end

	local function destroy()
		if not alive then
			return
		end

		if driving then
			leaveCar()
		end

		alive = false

		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)

		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		prompt:Destroy()
		handledCars[car] = nil
	end

	local function step(dt)
		if not isCarIntact() then
			destroy()
			return
		end

		local frameScale = dt * 60

		local steerTime = stats.steer_response_time_inactive
		local targetSteer = 0
		local mouseControlled = false

		if driving and not UserInputService:GetFocusedTextBox() then
			if mouseSteer then
				local viewportWidth = math.max(workspace.CurrentCamera.ViewportSize.X, 1)
				steerValue.Value = math.clamp((UserInputService:GetMouseLocation().X / viewportWidth) * 2 - 1, -1, 1)
				mouseControlled = true
			else
				local left = UserInputService:IsKeyDown(CONFIG.SteerLeftKey)
				local right = UserInputService:IsKeyDown(CONFIG.SteerRightKey)

				if left ~= right then
					targetSteer = if left then -1 else 1
					steerTime = stats.steer_response_time_active
				end
			end
		end

		if not mouseControlled then
			steerValue.Value = approach(steerValue.Value, targetSteer, steerTime, dt)
		end

		if steerSlide then
			steerSlide.Position = Vector3.new(steerValue.Value * -0.31, -1.17, -7.216)
		end

		local velocity = mass.AssemblyLinearVelocity
		local carSpeed = mass.CFrame:VectorToObjectSpace(velocity)
		local carSpeedFront = carSpeed.Z

		if drag then
			local aero = stats.aero
			local dragForce = Vector3.zero

			if aero and velocity.Magnitude > 0.01 then
				local magnitude = 7.5 * aero.rho * aero.Cd * aero.area * carSpeedFront * carSpeedFront
				dragForce = -velocity.Unit * Vector3.new(1, 0.5, 1) * magnitude
			end

			drag.Force = dragForce
		end

		local throttle = throttleValue.Value
		local brake = brakeValue.Value
		local clutch = clutchValue.Value

		local wheelRadius = math.max(stats.wheel_radius, 0.1)
		local gearRatio = transmission.gears[gear + 2] or 0
		local totalRatio = gearRatio * transmission.final_drive
		local engaged = clutch < 0.9 and totalRatio ~= 0

		if engaged then
			local wheelAngularSpeed = carSpeedFront / wheelRadius
			local syncRpm = math.abs(wheelAngularSpeed * totalRatio) * (30 / math.pi)
			engineRPM += (math.clamp(syncRpm, engineConfig.idlerpm, engineConfig.redline) - engineRPM)
				* math.min(dt * 10, 1)
		else
			local freeRevTarget = engineConfig.idlerpm + (engineConfig.redline - engineConfig.idlerpm) * throttle
			engineRPM += (freeRevTarget - engineRPM) * math.min(dt * (3 + throttle * 4), 1)
		end
		engineRPM = math.clamp(engineRPM, engineConfig.idlerpm, engineConfig.redline)
		car:SetAttribute("RPM", engineRPM)

		local engineTorque = getEngineTorque(engineConfig, engineRPM) * engineConfig.volumetric_efficiency * throttle
		local driveSpeed = 0

		if totalRatio ~= 0 then
			local wheelForce = (engineTorque * totalRatio * transmission.eff) / wheelRadius
			local direction = if totalRatio > 0 then 1 else -1
			driveSpeed = carSpeedFront + direction * (math.abs(wheelForce) / stats.mass) * 1.4
		end

		local wheelSpeed = (driveSpeed * (1 - clutch))
			+ -carSpeedFront * ((1 - throttle) * 1 - clutch) * (1 - brake)

		for _, attribute in WHEEL_SPEED_ATTRIBUTES do
			car:SetAttribute(attribute, wheelSpeed)
		end
		car:SetAttribute("rearWS", wheelSpeed)
		car:SetAttribute("frontWS", wheelSpeed)

		local tireEnd = car:GetAttribute("tireend")

		for _, wheel in ipairs(wheels:GetChildren()) do
			local speedAttribute = WHEEL_SPEED_ATTRIBUTES[wheel.Name]

			if speedAttribute then
				local tireInfo = TireSimulation.Update(car, wheel, raycastParams)
				if tireInfo then
					FrictionSimulation.Update(tireInfo)
				end

				local roll = wheel.Roll
				roll.Value = (roll.Value + car:GetAttribute(speedAttribute) / tireEnd * frameScale) % 360

				wheel.Bounds.SpinAtt.CFrame = CFrame.fromOrientation(math.rad(-roll.Value), 0, 0)
			end
		end
	end

	track(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not driving then
			return
		end

		local key = input.KeyCode

		if key == CONFIG.ThrottleKey then
			tweenValue(throttleValue, 1, stats.throttle_response_time)
		elseif key == CONFIG.BrakeKey then
			tweenValue(brakeValue, 1, stats.brake_response_time)
		elseif key == CONFIG.ClutchKey then
			tweenValue(clutchValue, 1, stats.clutch_response_time)
		elseif key == CONFIG.GearUpKey then
			if os.clock() - enteredAt > CONFIG.EnterInputGuard then
				shiftGear(1)
			end
		elseif key == CONFIG.GearDownKey then
			shiftGear(-1)
		elseif key == CONFIG.MouseSteerKey then
			mouseSteer = not mouseSteer
		elseif key == CONFIG.ExitKey then
			leaveCar()
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if not driving then
			return
		end

		local key = input.KeyCode

		if key == CONFIG.ThrottleKey then
			tweenValue(throttleValue, 0, stats.throttle_response_time / 2)
		elseif key == CONFIG.BrakeKey then
			tweenValue(brakeValue, 0, stats.brake_response_time / 2)
		elseif key == CONFIG.ClutchKey then
			tweenValue(clutchValue, 0, stats.clutch_response_time / 2)
		end
	end))

	track(prompt.Triggered:Connect(enterCar))

	track(player.CharacterRemoving:Connect(function()
		if driving then
			leaveCar()
		end
	end))

	track(car.AncestryChanged:Connect(function()
		if not car:IsDescendantOf(workspace) then
			destroy()
		end
	end))

	track(car.Destroying:Connect(destroy))

	task.delay(CONFIG.StartDelay, function()
		if not alive then
			return
		end

		mass.Anchored = false
		releaseControls(true)

		track(RunService.RenderStepped:Connect(step))

		if player.Character then
			player.Character:WaitForChild("Humanoid", 5)
			player.Character:WaitForChild("HumanoidRootPart", 5)
			enterCar()
		else
			local characterConnection
			characterConnection = player.CharacterAdded:Connect(function(newCharacter)
				if characterConnection then
					characterConnection:Disconnect()
				end
				newCharacter:WaitForChild("Humanoid", 5)
				newCharacter:WaitForChild("HumanoidRootPart", 5)
				enterCar()
			end)
			track(characterConnection)
		end
	end)
end

return UnifiedCarHandler
