	local fakeRpm = FAKE_ENGINE.idleRpm
	local lastRpmGear = 0

	engineRPM = stats.engine.idlerpm
	local transmission = stats.transmission
	local engineConfig = stats.engine

	local function track(connection)
		table.insert(connections, connection)
		return connection
	end

	local function tweenValue(value, target, duration)
		local previous = activeTweens[value]
		if previous then
			previous:Cancel()
		end

		local tween = TweenService:Create(value, TweenInfo.new(duration), { Value = target })
		activeTweens[value] = tween
		tween:Play()
	end

	local function releaseControls(parked)
		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		throttleValue.Value = 0
		clutchValue.Value = 0
		brakeValue.Value = if parked then 1 else 0
	end

	local function computeExitCFrame()
		if not (car:IsDescendantOf(workspace) and mass:IsDescendantOf(car)) then
			return entryCFrame
		end

		local massCFrame = mass.CFrame

		local side = -1
		if driverMass then
			side = if massCFrame:PointToObjectSpace(driverMass.Position).X < 0 then -1 else 1
		end

		local halfWidth = car:GetExtentsSize().X * 0.5
		local rightVector = flatten(massCFrame.RightVector, Vector3.xAxis)
		local lookVector = flatten(massCFrame.LookVector, -Vector3.zAxis)

		local position = massCFrame.Position
			+ rightVector * side * (halfWidth + CONFIG.ExitSideClearance)
			+ Vector3.yAxis * CONFIG.ExitHeight

		return CFrame.lookAt(position, position + lookVector)
	end

	local idleSnd, revSnd, whineSnd
	local idleOk, revOk, whineOk = false, false, false
	local sndWarned = {}

	local aRpm = FAKE_ENGINE.idleRpm
	local aThr = 0
	local aLoad = 0
	local aWhineSpd = 0

	local idleVol = 0
	local revVol = 0
	local whineVol = 0

	local prevSpd = 0
	local prevGear = gear
	local shiftTimer = 0

	local fadeTimer = 0
	local fadingOut = false
	local sndStopped = true

	local function warnMissingSnd(layerName)
		if not sndWarned[layerName] then
			sndWarned[layerName] = true
			warn(string.format("UnifiedCarHandler: %s is missing or invalid Sound 'Primary.%s' -- that audio layer will be disabled", car:GetFullName(), layerName))
		end
	end

	local function initSnd()
		local idleInst = primary:FindFirstChild("idle")
		local revInst = primary:FindFirstChild("rev")
		local whineInst = primary:FindFirstChild("whine")

		if idleInst and idleInst:IsA("Sound") then
			idleSnd = idleInst
			idleOk = true
			idleSnd.Looped = true
			idleSnd.Volume = 0
		else
			warnMissingSnd("Idle")
		end

		if revInst and revInst:IsA("Sound") then
			revSnd = revInst
			revOk = true
			revSnd.Looped = true
			revSnd.Volume = 0
			revSnd.PlaybackSpeed = SND_CFG.Rev.minPlayback
		else
			warnMissingSnd("Rev")
		end

		if whineInst and whineInst:IsA("Sound") then
			whineSnd = whineInst
			whineOk = true
			whineSnd.Looped = true
			whineSnd.Volume = 0
			whineSnd.PlaybackSpeed = SND_CFG.Whine.minPlayback
		else
			warnMissingSnd("Whine")
		end
	end

	local function startSnd()
		fadingOut = false
		fadeTimer = 0
		sndStopped = false

		aRpm = fakeRpm
		aThr = throttleValue.Value
		aLoad = 0
		aWhineSpd = 0
		prevSpd = 0
		prevGear = gear
		shiftTimer = 0

		if idleOk and not idleSnd.IsPlaying then
			idleSnd.Volume = 0
			idleSnd:Play()
		end

		if revOk and not revSnd.IsPlaying then
			revSnd.Volume = 0
			revSnd:Play()
		end

		if whineOk and not whineSnd.IsPlaying then
			whineSnd.Volume = 0
			whineSnd:Play()
		end
	end

	local function beginFade()
		if sndStopped then
			return
		end
		fadingOut = true
		fadeTimer = SND_CFG.FadeOutTime
	end

	local function stopSndNow()
		fadingOut = false
		fadeTimer = 0
		sndStopped = true

		if idleOk then
			idleSnd:Stop()
			idleSnd.Volume = 0
		end
		if revOk then
			revSnd:Stop()
			revSnd.Volume = 0
		end
		if whineOk then
			whineSnd:Stop()
			whineSnd.Volume = 0
		end
	end

	local function updateSnd(dt, throttle, clutch, currentGear, gearRatio, finalDrive, carSpeedFront, wheelRadius)
		if sndStopped and not driving then
			return
		end

		if not driving and not fadingOut and not sndStopped then
			beginFade()
		end

		if currentGear ~= prevGear then
			shiftTimer = SND_CFG.ShiftReactionTime
			prevGear = currentGear
		elseif shiftTimer > 0 then
			shiftTimer = math.max(0, shiftTimer - dt)
		end

		aRpm = smoothTo(aRpm, fakeRpm, SND_CFG.Rev.rpmSmoothing, dt)
		aThr = smoothTo(aThr, math.clamp(throttle, 0, 1), SND_CFG.Throttle.smoothing, dt)

		local couplingFactor = 1 - math.clamp(clutch, 0, 1)
		local neutralFactor = if currentGear == 0 then 0.3 else 1
		local rawLoad = math.clamp(throttle, 0, 1) * couplingFactor * neutralFactor
		aLoad = smoothTo(aLoad, rawLoad, SND_CFG.Load.smoothing, dt)

		local radius = math.max(wheelRadius, 0.1)
		local wheelAngularSpeed = math.abs(carSpeedFront) / radius
		local ratioForWhine = if gearRatio ~= 0 then math.abs(gearRatio) else 1
		local rawDriveSpeed = wheelAngularSpeed * ratioForWhine * finalDrive * SND_CFG.Whine.driveSpeedScale
		aWhineSpd = smoothTo(aWhineSpd, rawDriveSpeed, SND_CFG.Whine.smoothing, dt)

		local carAccel = (carSpeedFront - prevSpd) / math.max(dt, 1 / 240)
		prevSpd = carSpeedFront
		local accelFactor = math.clamp(carAccel / 25, -1, 1)

		if not driving then
			aThr = smoothTo(aThr, 0, SND_CFG.Throttle.smoothing, dt)
			aLoad = smoothTo(aLoad, 0, SND_CFG.Load.smoothing, dt)
		end

		local idleCfg = SND_CFG.Idle
		local idleFadeAlpha = math.clamp((aRpm - idleCfg.minRPM) / math.max(idleCfg.maxRPM - idleCfg.minRPM, 1), 0, 1)
		local idleTargetVolume = mix(idleCfg.maxVolume, idleCfg.minVolume, idleFadeAlpha)
		if not driving then
			idleTargetVolume = 0
		end
		idleVol = smoothTo(idleVol, idleTargetVolume, idleCfg.smoothing, dt)

		local revCfg = SND_CFG.Rev
		local revPlayback = rpmToRate(aRpm, revCfg.minRPM, revCfg.maxRPM, revCfg.minPlayback, revCfg.maxPlayback, revCfg.playbackCurve)
		revPlayback *= (1 + math.max(accelFactor, 0) * aLoad * revCfg.accelPlaybackBoost)

		local rpmPresence = math.clamp((aRpm - revCfg.minRPM) / math.max(revCfg.maxRPM - revCfg.minRPM, 1), 0, 1)
		local throttleLoadPresence = math.clamp(aThr * 0.45 + aLoad * 0.55, 0, 1)
		local revTargetVolume = mix(revCfg.baseVolume, revCfg.maxVolume, math.clamp(rpmPresence * 0.7 + throttleLoadPresence * 0.75, 0, 1))
		revTargetVolume += aLoad * revCfg.loadVolumeBoost
		revTargetVolume = math.clamp(revTargetVolume, 0, revCfg.maxVolume)

		if shiftTimer > 0 then
			local dipAlpha = shiftTimer / SND_CFG.ShiftReactionTime
			revTargetVolume *= (1 - SND_CFG.ShiftDipStrength * dipAlpha)
		end

		if not driving then
			revTargetVolume = 0
		end

		revVol = smoothTo(revVol, revTargetVolume, revCfg.smoothing, dt)

		local whineCfg = SND_CFG.Whine
		local whineAlpha = math.clamp((aWhineSpd - whineCfg.minSpeed) / math.max(whineCfg.maxSpeed - whineCfg.minSpeed, 1), 0, 1)
		local whinePlayback = mix(whineCfg.minPlayback, whineCfg.maxPlayback, whineAlpha)

		local whineTargetVolume = mix(whineCfg.baseVolume, whineCfg.maxVolume, whineAlpha)
		whineTargetVolume += aLoad * whineCfg.loadVolume
		whineTargetVolume *= (1 - math.clamp(clutch, 0, 1) * whineCfg.clutchRelease)
		whineTargetVolume = math.clamp(whineTargetVolume, 0, whineCfg.maxVolume)

		if not driving then
			whineTargetVolume = 0
		end

		whineVol = smoothTo(whineVol, whineTargetVolume, whineCfg.smoothing, dt)

		if idleOk then
			idleSnd.Volume = idleVol
		end

		if revOk then
			revSnd.Volume = revVol
			revSnd.PlaybackSpeed = revPlayback
		end

		if whineOk then
			whineSnd.Volume = whineVol
			whineSnd.PlaybackSpeed = whinePlayback
		end

		if fadingOut then
			fadeTimer -= dt
			local allSilent = idleVol < 0.01 and revVol < 0.01 and whineVol < 0.01
			if fadeTimer <= 0 or allSilent then
				stopSndNow()
			end
		end
	end

	local function leaveCar()
		if not driving then
			return
		end
		driving = false

		Hud.SetVisible(false)

		local exitCFrame = computeExitCFrame()

		releaseControls(true)

		if diedConnection then
			diedConnection:Disconnect()
			diedConnection = nil
		end

		setCollisionsEnabled(character, true, collisionCache)

		if rootPart and rootPart.Parent then
			rootPart.Anchored = false
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
			rootPart.CFrame = exitCFrame
		end

		character = nil
		humanoid = nil
		rootPart = nil

		beginFade()

		if alive and prompt.Parent then
			prompt.Enabled = true
		end
	end

	local function destroy()
		if not alive then
			return
		end

		if driving then
			leaveCar()
		end

		alive = false

		stopSndNow()

		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)

		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		prompt:Destroy()
		handledCars[car] = nil
	end

	local function onDriverDied()
		if not driving then
			return
		end

		if diedConnection then
			diedConnection:Disconnect()
			diedConnection = nil
		end

		driving = false
		alive = false

		stopSndNow()

		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)

		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		character = nil
		humanoid = nil
		rootPart = nil

		handledCars[car] = nil

		if car:IsDescendantOf(workspace) then
			car:Destroy()
		end
	end

	local function enterCar()
		if driving or not alive then
			return
		end

		local currentCharacter = player.Character
		local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
		local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")

		if not currentHumanoid or not currentRoot or currentHumanoid.Health <= 0 then
			return
		end

		setCollisionsEnabled(currentCharacter, false, collisionCache)

		driving = true
		enteredAt = os.clock()
		character = currentCharacter
		humanoid = currentHumanoid
		rootPart = currentRoot
		entryCFrame = currentRoot.CFrame

		if CONFIG.AutoFirstGearOnEnter and gear == 0 then
			gear = 1
		end

		prompt.Enabled = false
		releaseControls(false)

		Hud.SetVisible(false)
		startSnd()

		diedConnection = currentHumanoid.Died:Connect(onDriverDied)
	end

	local function shiftGear(direction)
		if clutchValue.Value <= 0.67 then
			return
		end

		task.wait(stats.transmission.shift_time)

		if not alive or not driving then
			return
		end

		local newGear = gear + direction
		if newGear > -2 and newGear < #stats.transmission.gears - 1 then
			gear = newGear
		end
	end

	local function isCarIntact()
		return car:IsDescendantOf(workspace) and mass.Parent ~= nil and primary.Parent ~= nil
	end

	local function step(dt)
		if not isCarIntact() then
			destroy()
			return
		end

		if driving and rootPart and rootPart.Parent then
			rootPart.CFrame = mass.CFrame
		end

		local frameScale = dt * 60

		local steerTime = stats.steer_response_time_inactive
		local targetSteer = 0
		local mouseControlled = false

		if driving and not UserInputService:GetFocusedTextBox() then
			if mouseSteer then
				local viewportWidth = math.max(workspace.CurrentCamera.ViewportSize.X, 1)
				steerValue.Value = math.clamp((UserInputService:GetMouseLocation().X / viewportWidth) * 2 - 1, -1, 1)
				mouseControlled = true
			else
				local left = UserInputService:IsKeyDown(CONFIG.SteerLeftKey)
				local right = UserInputService:IsKeyDown(CONFIG.SteerRightKey)

				if left ~= right then
					targetSteer = if left then -1 else 1
					steerTime = stats.steer_response_time_active
				end
			end
		end

		if not mouseControlled then
			steerValue.Value = approach(steerValue.Value, targetSteer, steerTime, dt)
		end

		if steerSlide then
			steerSlide.Position = Vector3.new(steerValue.Value * -0.31, -1.17, -7.216)
		end

		local velocity = mass.AssemblyLinearVelocity
		local carSpeed = mass.CFrame:VectorToObjectSpace(velocity)
		local carSpeedFront = carSpeed.Z

		if drag then
			local aero = stats.aero
			local dragForce = Vector3.zero

			if aero and velocity.Magnitude > 0.01 then
				local speedMS = carSpeedFront * CONFIG.StudsToMeters

				local magnitude =
					0.5
					* aero.rho
					* aero.Cd
					* aero.area
					* speedMS
					* speedMS

				dragForce = -velocity.Unit * Vector3.new(1, 0.5, 1) * magnitude
			end

			drag.Force = dragForce
		end

		local throttle = throttleValue.Value
		local brake = brakeValue.Value
		local clutch = clutchValue.Value

		local wheelRadius = math.max(stats.wheel_radius, 0.1)
		local gearRatio = transmission.gears[gear + 2] or 0
		local totalRatio = gearRatio * transmission.final_drive
		local inGear = totalRatio ~= 0

		if gear ~= lastRpmGear then
			fakeRpm = math.max(FAKE_ENGINE.idleRpm, fakeRpm - FAKE_ENGINE.shiftDrop)
			lastRpmGear = gear
		end

		local rpmTarget
		if clutch > 0.9 or gear == 0 then
			rpmTarget = FAKE_ENGINE.idleRpm + (FAKE_ENGINE.redlineRpm - FAKE_ENGINE.idleRpm) * throttle
		else
			local speedFactor = math.clamp(math.abs(carSpeedFront) / 40, 0, 1)
			local blend = math.clamp(throttle * 0.7 + speedFactor * 0.5, 0, 1)
			rpmTarget = FAKE_ENGINE.idleRpm + (FAKE_ENGINE.redlineRpm - FAKE_ENGINE.idleRpm) * blend
		end

		local rpmRate = if rpmTarget > fakeRpm then FAKE_ENGINE.revRateUp else FAKE_ENGINE.revRateDown
		fakeRpm += math.clamp(rpmTarget - fakeRpm, -rpmRate * dt, rpmRate * dt)

		if fakeRpm >= FAKE_ENGINE.redlineRpm then
			fakeRpm = FAKE_ENGINE.redlineRpm - math.random() * FAKE_ENGINE.revLimiterBounce
		end

		fakeRpm = math.clamp(fakeRpm, FAKE_ENGINE.idleRpm, FAKE_ENGINE.redlineRpm)
		car:SetAttribute("RPM", fakeRpm)

		local gearForce = GEAR_ACCEL_FORCE[gear] or 0
		local powerFactor = gearPower(gear, carSpeedFront)
		local driveInput = gearForce * throttle * (1 - clutch) * powerFactor

		local wheelSpeed = (carSpeedFront + driveInput * 1.25) * (1 - brake)

		for _, attribute in WHEEL_SPEED_ATTRIBUTES do
			car:SetAttribute(attribute, wheelSpeed)
		end
		car:SetAttribute("rearWS", wheelSpeed)
		car:SetAttribute("frontWS", wheelSpeed)

		if driving then
			local speedKmh = math.abs(carSpeedFront) * CONFIG.StudsToMeters * 3.6
			Hud.Update({
				gear = gear,
				speedKmh = speedKmh,
				rpm = fakeRpm,
				redlineRpm = FAKE_ENGINE.redlineRpm,
				redlineWarnRpm = FAKE_ENGINE.redlineRpm * 0.9,
				throttle = throttle,
				brake = brake,
				clutch = clutch,
			})
		end

		updateSnd(dt, throttle, clutch, gear, gearRatio, transmission.final_drive, carSpeedFront, wheelRadius)

		local tireEnd = car:GetAttribute("tireend")

		for _, wheel in ipairs(wheels:GetChildren()) do
			local speedAttribute = WHEEL_SPEED_ATTRIBUTES[wheel.Name]

			if speedAttribute then
				local tireInfo = TireSim.Update(car, wheel, raycastParams)
				if tireInfo then
					FrictionSim.Update(tireInfo)
				end

				local roll = wheel.Roll
				roll.Value = (roll.Value + car:GetAttribute(speedAttribute) / tireEnd * frameScale) % 360

				wheel.Bounds.SpinAtt.CFrame = CFrame.fromOrientation(math.rad(-roll.Value), 0, 0)
			end
		end
	end

	track(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not driving then
			return
		end

		local key = input.KeyCode

		if key == CONFIG.ThrottleKey then
			tweenValue(throttleValue, 1, stats.throttle_response_time)
		elseif key == CONFIG.BrakeKey then
			tweenValue(brakeValue, 1, stats.brake_response_time)
		elseif key == CONFIG.ClutchKey then
			tweenValue(clutchValue, 1, stats.clutch_response_time)
		elseif key == CONFIG.GearUpKey then
			if os.clock() - enteredAt > CONFIG.EnterInputGuard then
				shiftGear(1)
			end
		elseif key == CONFIG.GearDownKey then
			shiftGear(-1)
		elseif key == CONFIG.MouseSteerKey then
			mouseSteer = not mouseSteer
		elseif key == CONFIG.ExitKey then
			leaveCar()
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if not driving then
			return
		end

		local key = input.KeyCode

		if key == CONFIG.ThrottleKey then
			tweenValue(throttleValue, 0, stats.throttle_response_time / 2)
		elseif key == CONFIG.BrakeKey then
			tweenValue(brakeValue, 0, stats.brake_response_time / 2)
		elseif key == CONFIG.ClutchKey then
			tweenValue(clutchValue, 0, stats.clutch_response_time / 2)
		end
	end))

	track(prompt.Triggered:Connect(enterCar))

	track(player.CharacterRemoving:Connect(function()
		if driving then
			leaveCar()
		end
	end))

	track(car.AncestryChanged:Connect(function()
		if not car:IsDescendantOf(workspace) then
			destroy()
		end
	end))

	track(car.Destroying:Connect(destroy))

	initSnd()

	task.delay(CONFIG.StartDelay, function()
		if not alive then
			return
		end

		mass.Anchored = false
		releaseControls(true)

		track(RunService.RenderStepped:Connect(step))

		if player.Character then
			player.Character:WaitForChild("Humanoid", 5)
			player.Character:WaitForChild("HumanoidRootPart", 5)
			enterCar()
		else
			local characterConnection
			characterConnection = player.CharacterAdded:Connect(function(newCharacter)
				if characterConnection then
					characterConnection:Disconnect()
				end
				newCharacter:WaitForChild("Humanoid", 5)
				newCharacter:WaitForChild("HumanoidRootPart", 5)
				enterCar()
			end)
			track(characterConnection)
		end
	end)
end

return UnifiedCarHandler
