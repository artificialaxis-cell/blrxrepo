local Spring = {}
Spring.__index = Spring

local function solveSpring(mass, damping, stiffness, offset, velocity, force)
	local delta = damping * damping - 4 * stiffness / mass
	local particular = force / stiffness

	if delta > 0 then
		local root = math.sqrt(delta)
		local r1 = -0.5 * (damping + root)
		local r2 = -0.5 * (damping - root)
		local c1 = (r2 * offset - velocity) / (r2 - r1)
		local c2 = (r1 * offset - velocity) / (r1 - r2)

		return function(t)
			return c1 * math.exp(r1 * t) + c2 * math.exp(r2 * t) + particular
		end, function(t)
			return c1 * r1 * math.exp(r1 * t) + c2 * r2 * math.exp(r2 * t)
		end
	end

	if delta == 0 then
		local r = -damping / 2
		local c1 = offset
		local c2 = velocity - r * offset

		return function(t)
			return math.exp(r * t) * (c1 + c2 * t) + particular
		end, function(t)
			return math.exp(r * t) * (c2 * r * t + c1 * r + c2)
		end
	end

	local r = -damping / 2
	local s = math.sqrt(-delta)
	local c1 = offset
	local c2 = (velocity - r * offset) / s

	return function(t)
		return math.exp(r * t) * (c1 * math.cos(s * t) + c2 * math.sin(s * t)) + particular
	end, function(t)
		return math.exp(r * t) * ((r * c1 + c2 * s) * math.cos(s * t) + (r * c2 - c1 * s) * math.sin(s * t))
	end
end

function Spring.new(mass, damping, stiffness)
	local self = setmetatable({
		mass = mass,
		damping = damping,
		stiffness = stiffness,
	}, Spring)

	self:_restart(0, 0, 0)

	return self
end

function Spring:_restart(offset, velocity, goal)
	self.offsetAt, self.velocityAt = solveSpring(
		self.mass,
		self.damping,
		self.stiffness,
		offset - goal,
		velocity,
		goal * self.stiffness
	)
	self.startTime = os.clock()
end

function Spring:GetOffset()
	return self.offsetAt(os.clock() - self.startTime)
end

function Spring:GetVelocity()
	return self.velocityAt(os.clock() - self.startTime)
end

function Spring:SetGoal(goal)
	self:_restart(self:GetOffset(), self:GetVelocity(), goal)
end

local function createCameraController(car)
	local mass = car.Mass
	local primary = car.Primary

	local controller = {}

	local camera
	local enabled = false
	local state = 1
	local savedFov = 70

	local orbitAngleH = 0
	local orbitAngleV = CAMERA.defaultVerticalAngle
	local orbitDistance = CAMERA.defaultDistance
	local targetOrbitDistance = CAMERA.defaultDistance
	local lateralLean = 0

	local lastCarVelocity = Vector3.zero
	local mouseDown = false
	local lastMousePosition = Vector2.zero
	local thumbstickInput = Vector2.zero

	local springX, springY, springZ
	local inputConnections = {}

	local function resetSprings()
		springX = Spring.new(CAMERA.positionMass, CAMERA.positionDamping, CAMERA.positionStiffness)
		springY = Spring.new(CAMERA.positionMass, CAMERA.positionDamping, CAMERA.positionStiffness)
		springZ = Spring.new(CAMERA.positionMass, CAMERA.positionDamping, CAMERA.positionStiffness)
	end

	local function calculateLateralLean(lateralVelocity, speed, dt)
		local speedFactor = math.clamp(speed / 290, 0, 1)
		local gForce = lateralVelocity * 0.5
		local targetLean = math.clamp(
			gForce * CAMERA.maxLateralLean * speedFactor,
			-CAMERA.maxLateralLean,
			CAMERA.maxLateralLean
		)

		lateralLean += (targetLean - lateralLean) * math.min(dt * CAMERA.leanSpeed, 1)

		return lateralLean
	end

	function controller:Enable()
		if enabled then
			return
		end
		enabled = true

		camera = workspace.CurrentCamera
		savedFov = camera.FieldOfView
		lastCarVelocity = mass.AssemblyLinearVelocity

		orbitAngleH = 0
		orbitAngleV = CAMERA.defaultVerticalAngle
		orbitDistance = CAMERA.defaultDistance
		targetOrbitDistance = CAMERA.defaultDistance
		lateralLean = 0
		mouseDown = false
		thumbstickInput = Vector2.zero
		resetSprings()

		table.insert(inputConnections, UserInputService.InputBegan:Connect(function(input, processed)
			if processed then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				mouseDown = true
				lastMousePosition = Vector2.new(input.Position.X, input.Position.Y)
			end
		end))

		table.insert(inputConnections, UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				mouseDown = false
			end
		end))

		table.insert(inputConnections, UserInputService.InputChanged:Connect(function(input, processed)
			if processed then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseMovement and mouseDown then
				local position = Vector2.new(input.Position.X, input.Position.Y)
				local delta = position - lastMousePosition
				orbitAngleH -= delta.X * CAMERA.mouseSensitivity
				orbitAngleV = math.clamp(
					orbitAngleV + delta.Y * CAMERA.mouseSensitivity,
					CAMERA.minVerticalAngle,
					CAMERA.maxVerticalAngle
				)
				lastMousePosition = position
			end

			if input.UserInputType == Enum.UserInputType.Gamepad1 and input.KeyCode == Enum.KeyCode.Thumbstick2 then
				thumbstickInput = Vector2.new(input.Position.X, input.Position.Y)
			end

			if input.UserInputType == Enum.UserInputType.MouseWheel then
				targetOrbitDistance = math.clamp(
					targetOrbitDistance - input.Position.Z * CAMERA.zoomSpeed,
					CAMERA.minDistance,
					CAMERA.maxDistance
				)
			end
		end))

		if state == 1 then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = primary
		end
	end

	function controller:Disable(subject)
		if not enabled then
			return
		end
		enabled = false

		for _, connection in inputConnections do
			connection:Disconnect()
		end
		table.clear(inputConnections)

		camera = workspace.CurrentCamera
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = savedFov
			if subject then
				camera.CameraSubject = subject
			end
		end
	end

	function controller:ChangeState()
		state = if state == 1 then 2 else 1
		resetSprings()
	end

	function controller:Update(dt)
		if not enabled or not mass.Parent or not primary.Parent then
			return
		end

		camera = workspace.CurrentCamera

		if state == 1 then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = primary
			camera.FieldOfView += (savedFov - camera.FieldOfView) * math.min(dt * CAMERA.fovResponse, 1)
			lastCarVelocity = mass.AssemblyLinearVelocity
			return
		end

		camera.CameraType = Enum.CameraType.Scriptable

		local carVelocity = mass.AssemblyLinearVelocity
		local carCFrame = mass.CFrame
		local basePosition = primary.Position

		local localVelocity = carCFrame:VectorToObjectSpace(carVelocity)
		local speed = carVelocity.Magnitude * 0.28

		local acceleration = (carVelocity - lastCarVelocity) / dt
		local forwardAcceleration = carCFrame.LookVector:Dot(acceleration)
		lastCarVelocity = carVelocity

		if math.abs(forwardAcceleration) > CAMERA.accelerationThreshold then
			orbitAngleH += (0 - orbitAngleH) * math.min(dt * CAMERA.horizontalResetSpeed, 1)
		end

		if thumbstickInput.Magnitude > 0.1 then
			orbitAngleH -= thumbstickInput.X * CAMERA.thumbstickSensitivity * dt
			orbitAngleV = math.clamp(
				orbitAngleV - thumbstickInput.Y * CAMERA.thumbstickSensitivity * dt,
				CAMERA.minVerticalAngle,
				CAMERA.maxVerticalAngle
			)
		end

		orbitDistance += (targetOrbitDistance - orbitDistance) * dt * CAMERA.distanceResponse

		local carYaw = math.atan2(-carCFrame.LookVector.X, -carCFrame.LookVector.Z)
		local horizontalRad = carYaw + math.rad(orbitAngleH)
		local verticalRad = math.rad(orbitAngleV)

		local offset = Vector3.new(
			math.sin(horizontalRad) * math.cos(verticalRad) * orbitDistance,
			math.sin(verticalRad) * orbitDistance,
			math.cos(horizontalRad) * math.cos(verticalRad) * orbitDistance
		)

		local lean = calculateLateralLean(localVelocity.X, speed, dt)

		springX:SetGoal(offset.X)
		springY:SetGoal(offset.Y)
		springZ:SetGoal(offset.Z)

		local smoothedPosition = basePosition + Vector3.new(
			springX:GetOffset(),
			springY:GetOffset(),
			springZ:GetOffset()
		)

		local lookAtPosition = basePosition
		if carVelocity.Magnitude > 0.01 then
			lookAtPosition += carVelocity.Unit * math.min(speed * 0.3, 5)
		end

		local lookDirection = (lookAtPosition - smoothedPosition).Unit
		local upVector = Vector3.yAxis

		local leanRad = math.rad(lean)
		local right = lookDirection:Cross(upVector).Unit
		upVector = (upVector * math.cos(leanRad) + right * math.sin(leanRad)).Unit

		camera.CFrame = CFrame.lookAt(smoothedPosition, lookAtPosition, upVector)

		local targetFov = math.clamp(savedFov + carVelocity.Magnitude / 5, savedFov, savedFov + CAMERA.fovRange)
		camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(4 * dt, 1)

		local shakeVelocity = carVelocity.Magnitude - CAMERA.shakeVelocityThreshold
		if shakeVelocity > 0 then
			local range = math.floor(shakeVelocity)
			camera.CFrame *= CFrame.Angles(
				math.rad(math.random(-range, range) / 1000),
				math.rad(math.random(-range, range) / 1000),
				math.rad(math.random(-range, range) / 1000)
			)
		end
	end

	return controller
end

local TireSimulation = {}

local SAMPLE_RADII = { 0.1, 0.2, 0.3, 0.4 }
local DIAGONAL = math.sqrt(0.5)
local SAMPLE_OFFSETS = {}

for _, radius in ipairs(SAMPLE_RADII) do
	table.insert(SAMPLE_OFFSETS, { radius, 0 })
	table.insert(SAMPLE_OFFSETS, { -radius, 0 })
	table.insert(SAMPLE_OFFSETS, { 0, radius })
	table.insert(SAMPLE_OFFSETS, { 0, -radius })
end

for _, radius in ipairs(SAMPLE_RADII) do
	local diagonal = radius * DIAGONAL
	table.insert(SAMPLE_OFFSETS, { diagonal, diagonal })
	table.insert(SAMPLE_OFFSETS, { diagonal, -diagonal })
	table.insert(SAMPLE_OFFSETS, { -diagonal, diagonal })
	table.insert(SAMPLE_OFFSETS, { -diagonal, -diagonal })
end

local function getContactPoint(tire, origin, rayLength, raycastParams)
	local cframe = tire.CFrame
	local right = cframe.RightVector
	local forward = cframe.LookVector
	local direction = -cframe.UpVector * rayLength

	local hitPoints = {}
	local normals = {}
	local materialCounts = {}
	local hitCount = 0

	local function cast(rayOrigin)
		local result = workspace:Raycast(rayOrigin, direction, raycastParams)
		if result then
			hitCount += 1
			hitPoints[hitCount] = result.Position
			normals[hitCount] = result.Normal
			materialCounts[result.Material] = (materialCounts[result.Material] or 0) + 1
		end
	end

	cast(origin)
	for _, offset in ipairs(SAMPLE_OFFSETS) do
		cast(origin + right * offset[1] + forward * offset[2])
	end

	if hitCount == 0 then
		return nil
	end

	local highestY = -math.huge
	for i = 1, hitCount do
		highestY = math.max(highestY, hitPoints[i].Y)
	end

	local positionSum = Vector3.zero
	local normalSum = Vector3.zero
	local keptCount = 0

	for i = 1, hitCount do
		if highestY - hitPoints[i].Y <= 0.05 then
			positionSum += hitPoints[i]
			normalSum += normals[i]
			keptCount += 1
		end
	end

	local averageNormal = if normalSum.Magnitude > 1e-6 then normalSum.Unit else Vector3.yAxis

	local commonMaterial
	local highestCount = 0
	for material, count in pairs(materialCounts) do
		if count > highestCount then
			commonMaterial = material
			highestCount = count
		end
	end

	return positionSum / keptCount, averageNormal, commonMaterial
end

local stat = {}

function TireSimulation.Update(car, wheel, raycastParams)
	local springStrength = car:GetAttribute("psi") * 300
	local damper = car:GetAttribute("damper")
	local tireStart = car:GetAttribute("tirestart")
	local tireEnd = car:GetAttribute("tireend")
	local contactRadius = tireEnd + 0.35 - tireStart

	local tire = wheel.Bounds
	local up = tire.CFrame.UpVector

	local startPosition = tire.Position - up * tireStart
	tire.TIRESTART.WorldPosition = startPosition
	tire.TIREEND.WorldPosition = tire.Position - up * tireEnd

	local tireForce = tire.TireForce
	local frictionForce = tire.FrictionForce

	local contactPosition, groundNormal, groundMaterial = getContactPoint(tire, startPosition, contactRadius, raycastParams)

	if not contactPosition then
		tireForce.Force = Vector3.zero
		frictionForce.Force = Vector3.zero
		return nil
	end

	tire.ForceAtt.WorldPosition = contactPosition

	local suspensionLength = startPosition.Y - contactPosition.Y
	local compression = suspensionLength - contactRadius

	local springForce = -springStrength * compression
	local damperForce = -damper * tire.AssemblyLinearVelocity.Y

	tireForce.Force = groundNormal * (springForce + damperForce)

	return {
		folder = wheel,
		tire = tire,
		CPos = contactPosition,
		car = car,
		grM = groundMaterial,
	}
end

