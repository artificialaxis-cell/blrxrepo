local function RenameClones(parent)
	for originalName, clones in pairs(RenameTable) do
		for _, cloneName in ipairs(clones) do
			local child = parent:FindFirstChild(cloneName,true)
			if child then
				child.Name = originalName
			end
		end
	end
end

local function resolveCar(car)
	for _, name in ipairs(REQUIRED_CHILDREN) do
		if not car:FindFirstChild(name) then
			warn(string.format("UnifiedCarHandler: %s is missing '%s'", car:GetFullName(), name))
			return nil
		end
	end

	for _, name in ipairs(REQUIRED_ATTRIBUTES) do
		if typeof(car:GetAttribute(name)) ~= "number" then
			warn(string.format("UnifiedCarHandler: %s is missing numeric attribute '%s'", car:GetFullName(), name))
			return nil
		end
	end

	RenameClones(car)

	local mass = car.Mass
	local primary = car.Primary

	if not (mass:IsA("BasePart") and primary:IsA("BasePart")) then
		warn(string.format("UnifiedCarHandler: %s has Mass, Primary or Stats of the wrong type", car:GetFullName()))
		return nil
	end

	local driverMass = car:FindFirstChild("DriverMass")
	if driverMass and not driverMass:IsA("BasePart") then
		driverMass = nil
	end

	local drag = mass:FindFirstChild("Drag")
	if drag and not drag:IsA("VectorForce") then
		drag = nil
	end

	local steerSlide = primary:FindFirstChild("SteerSlide")
	if steerSlide and not steerSlide:IsA("Attachment") then
		steerSlide = nil
	end

	return {
		wheels = car.Wheels,
		stats = stat,
		mass = mass,
		primary = primary,
		throttleValue = car.Throttle,
		brakeValue = car.Brake,
		clutchValue = car.Clutch,
		steerValue = car.Steer,
		driverMass = driverMass,
		drag = drag,
		steerSlide = steerSlide,
	}
end

local function flatten(vector, fallback)
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 0.01 then
		return fallback
	end

	return flat.Unit
end

local function approach(current, target, speed, dt)
	if current < target then
		return math.min(current + speed * dt, target)
	end

	if current > target then
		return math.max(current - speed * dt, target)
	end

	return current
end

local function getEngineTorque(engine, rpm)
	local curve = engine.torqueCurve
	local points = engine._torqueRpmPoints

	if not points then
		points = {}
		for point in pairs(curve) do
			table.insert(points, point)
		end
		table.sort(points)
		engine._torqueRpmPoints = points
	end

	if rpm <= points[1] then
		return curve[points[1]]
	end

	if rpm >= points[#points] then
		return curve[points[#points]]
	end

	for i = 1, #points - 1 do
		local lower, upper = points[i], points[i + 1]
		if rpm >= lower and rpm <= upper then
			local alpha = (rpm - lower) / (upper - lower)
			return curve[lower] + (curve[upper] - curve[lower]) * alpha
		end
	end

	return curve[points[#points]]
end

