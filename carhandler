local SAMPLE_RADII = { 0.1, 0.2, 0.3, 0.4 }
local DIAGONAL = math.sqrt(0.5)
local SAMPLE_OFFSETS = {}

for _, radius in ipairs(SAMPLE_RADII) do
	table.insert(SAMPLE_OFFSETS, { radius, 0 })
	table.insert(SAMPLE_OFFSETS, { -radius, 0 })
	table.insert(SAMPLE_OFFSETS, { 0, radius })
	table.insert(SAMPLE_OFFSETS, { 0, -radius })
end

for _, radius in ipairs(SAMPLE_RADII) do
	local diagonal = radius * DIAGONAL
	table.insert(SAMPLE_OFFSETS, { diagonal, diagonal })
	table.insert(SAMPLE_OFFSETS, { diagonal, -diagonal })
	table.insert(SAMPLE_OFFSETS, { -diagonal, diagonal })
	table.insert(SAMPLE_OFFSETS, { -diagonal, -diagonal })
end

local function getContactPoint(tire, origin, rayLength, raycastParams)
	local cframe = tire.CFrame
	local right = cframe.RightVector
	local forward = cframe.LookVector
	local direction = -cframe.UpVector * rayLength

	local hitPoints = {}
	local normals = {}
	local materialCounts = {}
	local hitCount = 0

	local function cast(rayOrigin)
		local result = workspace:Raycast(rayOrigin, direction, raycastParams)
		if result then
			hitCount += 1
			hitPoints[hitCount] = result.Position
			normals[hitCount] = result.Normal
			materialCounts[result.Material] = (materialCounts[result.Material] or 0) + 1
		end
	end

	cast(origin)
	for _, offset in ipairs(SAMPLE_OFFSETS) do
		cast(origin + right * offset[1] + forward * offset[2])
	end

	if hitCount == 0 then
		return nil
	end

	local highestY = -math.huge
	for i = 1, hitCount do
		highestY = math.max(highestY, hitPoints[i].Y)
	end

	local positionSum = Vector3.zero
	local normalSum = Vector3.zero
	local keptCount = 0

	for i = 1, hitCount do
		if highestY - hitPoints[i].Y <= 0.05 then
			positionSum += hitPoints[i]
			normalSum += normals[i]
			keptCount += 1
		end
	end

	local averageNormal = if normalSum.Magnitude > 1e-6 then normalSum.Unit else Vector3.yAxis

	local commonMaterial
	local highestCount = 0
	for material, count in pairs(materialCounts) do
		if count > highestCount then
			commonMaterial = material
			highestCount = count
		end
	end

	return positionSum / keptCount, averageNormal, commonMaterial
end

local stat = {}

function TireSimulation.Update(car, wheel, raycastParams)
	local springStrength = car:GetAttribute("psi") * 300
	local damper = car:GetAttribute("damper")
	local tireStart = car:GetAttribute("tirestart")
	local tireEnd = car:GetAttribute("tireend")
	local contactRadius = tireEnd + 0.35 - tireStart

	local tire = wheel.Bounds
	local up = tire.CFrame.UpVector

	local startPosition = tire.Position - up * tireStart
	tire.TIRESTART.WorldPosition = startPosition
	tire.TIREEND.WorldPosition = tire.Position - up * tireEnd

	local tireForce = tire.TireForce
	local frictionForce = tire.FrictionForce

	local contactPosition, groundNormal, groundMaterial = getContactPoint(tire, startPosition, contactRadius, raycastParams)

	if not contactPosition then
		tireForce.Force = Vector3.zero
		frictionForce.Force = Vector3.zero
		return nil
	end

	tire.ForceAtt.WorldPosition = contactPosition

	local suspensionLength = startPosition.Y - contactPosition.Y
	local compression = suspensionLength - contactRadius

	local springForce = -springStrength * compression
	local damperForce = -damper * tire.AssemblyLinearVelocity.Y

	tireForce.Force = groundNormal * (springForce + damperForce)

	return {
		folder = wheel,
		tire = tire,
		CPos = contactPosition,
		car = car,
		grM = groundMaterial,
	}
end

