--==========================================================================--
-- UNITS
--==========================================================================--

local Units = {}
Units.StudsToMeters = 0.28
Units.MetersToStuds = 1 / Units.StudsToMeters
-- Ratio between this rig's Roblox AssemblyMass numbers and real kilograms.
-- See the unit notes at the top of this file. Tune per-experience.
Units.MassScale = 1
Units.ForceScale = Units.MassScale / Units.StudsToMeters -- multiply Newtons by this to get Roblox force units

function Units.RobloxForceToNewtons(robloxForce)
	return robloxForce / Units.ForceScale
end

function Units.RadPerSecToRPM(omega)
	return omega * 60 / (2 * math.pi)
end

function Units.RPMToRadPerSec(rpm)
	return rpm * 2 * math.pi / 60
end

function Units.MpsToStudsPerSec(mps)
	return mps * Units.MetersToStuds
end

function Units.StudsPerSecToMps(sps)
	return sps * Units.StudsToMeters
end

local function lerp(a, b, t)
	return a + (b - a) * math.clamp(t, 0, 1)
end

local function smoothTo(current, target, rate, dt)
	local alpha = 1 - math.exp(-math.max(rate, 0) * dt)
	return current + (target - current) * alpha
end

local function flatten(vector, fallback)
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 0.01 then
		return fallback
	end
	return flat.Unit
end

local function approach(current, target, speed, dt)
	if current < target then
		return math.min(current + speed * dt, target)
	elseif current > target then
		return math.max(current - speed * dt, target)
	end
	return current
end

--==========================================================================--
-- ENGINE SIM
--
-- omega is integrated from net torque / inertia every frame -- RPM is a
-- readout of that integration, never a target that gets chased.
--==========================================================================--

local EngineSim = {}
EngineSim.__index = EngineSim

function EngineSim.new(config)
	local self = setmetatable({}, EngineSim)

	self.idleRPM = config.idleRPM or 900
	self.redlineRPM = config.redlineRPM or 7000
	self.inertia = config.inertia or 0.15 -- kg*m^2 (flywheel + reciprocating assembly, real value)

	self.torqueCurve = config.torqueCurve
	self.torquePoints = {}
	for rpm in pairs(self.torqueCurve) do
		table.insert(self.torquePoints, rpm)
	end
	table.sort(self.torquePoints)
	assert(#self.torquePoints >= 2, "EngineSim requires at least 2 torqueCurve points")

	local friction = config.friction or {}
	-- Static friction: constant drag torque (Nm) from piston rings/bearings, roughly RPM-independent.
	self.staticFriction = friction.static or 12
	-- Viscous friction: Nm per rad/s, oil shear losses that grow with RPM.
	self.viscous = friction.viscous or 0.010
	-- Pumping losses: Nm per (rad/s)^2, throttle-plate/intake pumping work, grows with the square of RPM.
	self.pumpingLossCoefficient = friction.pumpingLossCoefficient or 0.0009
	-- Constant parasitic load from alternator/water pump/power steering etc.
	self.accessoryTorque = config.accessoryTorque or 6

	self.idleControl = config.idleControl or {}
	if self.idleControl.enabled == nil then
		self.idleControl.enabled = true
	end
	self.idleControl.targetRPM = self.idleControl.targetRPM or self.idleRPM
	self.idleControl.authority = self.idleControl.authority or 0.55
	self.idleControl.stallRPM = self.idleControl.stallRPM or (self.idleRPM * 0.35)

	self.revLimiter = config.revLimiter or {}
	self.revLimiter.rpm = self.revLimiter.rpm or self.redlineRPM
	self.revLimiter.cut = self.revLimiter.cut or 1.0
	self.revLimiter.hysteresis = self.revLimiter.hysteresis or 120

	self.omega = Units.RPMToRadPerSec(self.idleRPM)
	self.stalled = false
	self.limiterActive = false
	self.lastCombustionTorque = 0
	self.lastNetTorque = 0

	return self
end

function EngineSim:_combustionTorqueAt(rpm, throttle)
	local points = self.torquePoints
	local curve = self.torqueCurve
	local maxTorque

	if rpm <= points[1] then
		maxTorque = curve[points[1]]
	elseif rpm >= points[#points] then
		maxTorque = curve[points[#points]]
	else
		maxTorque = curve[points[#points]]
		for i = 1, #points - 1 do
			local lo, hi = points[i], points[i + 1]
			if rpm >= lo and rpm <= hi then
				local alpha = (rpm - lo) / (hi - lo)
				maxTorque = curve[lo] + (curve[hi] - curve[lo]) * alpha
				break
			end
		end
	end

	return maxTorque * math.clamp(throttle, 0, 1)
end

-- loadTorque: reaction torque fed back from the clutch (Nm). Positive opposes engine rotation.
function EngineSim:Update(dt, throttle, loadTorque)
	loadTorque = loadTorque or 0
	local rpm = self:GetRPM()

	local idleThrottle = 0
	if self.idleControl.enabled and rpm < self.idleControl.targetRPM * 1.05 then
		local deficit = (self.idleControl.targetRPM - rpm) / self.idleControl.targetRPM
		idleThrottle = math.clamp(deficit * self.idleControl.authority, 0, 1)
	end
	local effectiveThrottle = math.max(math.clamp(throttle, 0, 1), idleThrottle)

	if rpm >= self.revLimiter.rpm then
		self.limiterActive = true
	elseif rpm < self.revLimiter.rpm - self.revLimiter.hysteresis then
		self.limiterActive = false
	end
	if self.limiterActive then
		effectiveThrottle = effectiveThrottle * (1 - self.revLimiter.cut)
	end

	local combustionTorque = self:_combustionTorqueAt(rpm, effectiveThrottle)
	local frictionTorque = self.staticFriction + self.viscous * self.omega
	local pumpingLoss = self.pumpingLossCoefficient * self.omega * self.omega

	if self.stalled then
		combustionTorque = 0
	end

	local netTorque = combustionTorque - frictionTorque - pumpingLoss - self.accessoryTorque - loadTorque

	if not self.stalled and rpm < self.idleControl.stallRPM and netTorque < 0 then
		self.stalled = true
		combustionTorque = 0
		netTorque = -frictionTorque - pumpingLoss - loadTorque
	end

	local angularAcceleration = netTorque / self.inertia
	self.omega = math.max(self.omega + angularAcceleration * dt, 0)

	self.lastCombustionTorque = combustionTorque
	self.lastNetTorque = netTorque

	return self.omega
end

function EngineSim:Restart()
	if self.omega < Units.RPMToRadPerSec(self.idleControl.stallRPM) then
		self.omega = Units.RPMToRadPerSec(self.idleRPM)
	end
	self.stalled = false
end

function EngineSim:GetRPM()
	return Units.RadPerSecToRPM(self.omega)
end

function EngineSim:GetAngularVelocity()
	return self.omega
end

function EngineSim:IsStalled()
	return self.stalled
end

--==========================================================================--
-- CLUTCH SIM
--
-- IMPLICIT synchronization model (numerically stable at any frame rate/dt).
--
-- A naive clutch model applies torque proportional to slip ("torque =
-- stiffness * (engineOmega - transOmega)") -- but that is a stiff spring,
-- and integrating a stiff spring with explicit Euler at a variable Roblox
-- frame rate blows up the moment dt isn't tiny compared to inertia/stiffness
-- (exactly the wheel-speed oscillation / instability this replaces).
--
-- Instead, each step we solve directly for the torque that would bring the
-- engine and the reflected transmission-input inertia to the SAME angular
-- velocity by the end of this exact timestep, then clamp that to the
-- clutch's torque capacity. This is unconditionally stable: it never
-- overshoots, regardless of how large or small dt is, because it is derived
-- from the timestep itself rather than an arbitrary spring constant.
--
-- Derivation: applying torque T to the engine (inertia Ie) and -T to the
-- reflected transmission side (inertia Ir) for a duration dt changes their
-- speeds by -T/Ie*dt and +T/Ir*dt respectively. Setting the two resulting
-- speeds equal and solving for T gives:
--     T = (omegaEngine - omegaTrans) * (Ie*Ir) / ((Ie+Ir) * dt)
-- Clamping |T| to the clutch's pedal-scaled capacity is what allows slip
-- (a slipping clutch) instead of full synchronization.
--==========================================================================--

local ClutchSim = {}
ClutchSim.__index = ClutchSim

function ClutchSim.new(config)
	local self = setmetatable({}, ClutchSim)
	self.maxTorque = config.maxTorque or 380 -- Nm, full engagement holding capacity
	self.slip = 0
	self.lastTorque = 0
	return self
end

-- pedal: 0 = fully released/engaged, 1 = fully pressed/disengaged
-- reflectedInertia: the transmission-input-side inertia (kg*m^2) as seen through the current gear
-- (i.e. driven-wheel inertia divided by totalRatio^2). Pass 0 when the drivetrain side is disconnected
-- (neutral) -- the clutch then transmits nothing regardless of pedal position.
function ClutchSim:Update(dt, engineOmega, engineInertia, transInputOmega, reflectedInertia, pedal)
	local capacity = self.maxTorque * math.clamp(1 - pedal, 0, 1)
	self.slip = engineOmega - transInputOmega

	if capacity <= 0.001 or reflectedInertia <= 0 or engineInertia <= 0 then
		self.lastTorque = 0
		return 0
	end

	local combinedInertia = (engineInertia * reflectedInertia) / (engineInertia + reflectedInertia)
	local syncTorque = self.slip * combinedInertia / math.max(dt, 1 / 480)
	local torque = math.clamp(syncTorque, -capacity, capacity)
	self.lastTorque = torque
	return torque
end

function ClutchSim:GetSlip()
	return self.slip
end

--==========================================================================--
-- TRANSMISSION SIM
--==========================================================================--

local TransmissionSim = {}
TransmissionSim.__index = TransmissionSim

function TransmissionSim.new(config)
	local self = setmetatable({}, TransmissionSim)
	self.gears = config.gears -- indexed table: [-1] = reverse, [0] = neutral, [1..N] = forward
	self.finalDrive = config.finalDrive or 3.9
	self.efficiency = config.efficiency or 0.94
	self.shiftTime = config.shiftTime or 0.18
	self.currentGear = 0
	self.pendingGear = 0
	self.shifting = false
	self.shiftTimer = 0
	return self
end

function TransmissionSim:GetGear()
	return self.currentGear
end

function TransmissionSim:GetRatio(gear)
	return self.gears[gear or self.currentGear] or 0
end

function TransmissionSim:IsShifting()
	return self.shifting
end

function TransmissionSim:RequestShift(gear)
	if self.gears[gear] == nil or self.shifting or gear == self.currentGear then
		return false
	end
	self.pendingGear = gear
	self.shifting = true
	self.shiftTimer = self.shiftTime
	return true
end

function TransmissionSim:Update(dt)
	if self.shifting then
		self.shiftTimer -= dt
		if self.shiftTimer <= 0 then
			self.currentGear = self.pendingGear
			self.shifting = false
		end
	end
end

-- inputTorque (Nm, from the clutch) -> driveshaft torque (Nm). Zero during a shift (torque interrupt).
function TransmissionSim:GetOutputTorque(inputTorque)
	if self.shifting then
		return 0
	end
	return inputTorque * self:GetRatio() * self.finalDrive * self.efficiency
end

function TransmissionSim:GetTotalRatio()
	return self:GetRatio() * self.finalDrive
end

-- The engine/transmission-input angular speed required to match a given driveshaft speed with zero slip.
function TransmissionSim:RequiredInputOmega(driveshaftOmega)
	local totalRatio = self:GetTotalRatio()
	if totalRatio == 0 then
		return 0
	end
	return driveshaftOmega * totalRatio
end

--==========================================================================--
-- DIFFERENTIAL SIM
--
-- Splits driveshaft torque between the two wheels of one axle. Modular by
-- design: adding a new type only means adding a branch here.
--==========================================================================--

local DifferentialSim = {}
DifferentialSim.__index = DifferentialSim

function DifferentialSim.new(config)
	local self = setmetatable({}, DifferentialSim)
	self.type = (config.type or "OPEN"):upper()
	self.preload = config.preload or 15 -- Nm, base bias torque available even at zero slip (LSD only)
	self.powerLock = config.powerLock or 0.35 -- 0-1, locking bias fraction while driving
	self.coastLock = config.coastLock or 0.15 -- 0-1, locking bias fraction while coasting/engine braking
	self.maxBias = config.maxBias or 3 -- max torque ratio between the two output wheels
	return self
end

-- inputTorque: driveshaft torque delivered to this differential (Nm)
-- omegaA/omegaB: angular velocities (rad/s) of the two output members
-- inertiaA/inertiaB: rotational inertia (kg*m^2) of the two output members -- only needed by
-- LOCKED/WELDED, which (like the clutch above) solves for the implicit synchronization torque
-- rather than using an explicit stiffness gain, so it stays stable at any timestep.
-- returns torqueA, torqueB (Nm)
function DifferentialSim:Distribute(dt, inputTorque, omegaA, omegaB, inertiaA, inertiaB)
	local half = inputTorque * 0.5

	if self.type == "OPEN" then
		return half, half
	end

	local omegaDiff = omegaA - omegaB
	local biasCap = math.abs(inputTorque) * (self.maxBias - 1) * 0.5

	if self.type == "LOCKED" or self.type == "WELDED" then
		local Ia = math.max(inertiaA or 1, 0.01)
		local Ib = math.max(inertiaB or 1, 0.01)
		local combinedInertia = (Ia * Ib) / (Ia + Ib)
		local syncTorque = omegaDiff * combinedInertia / math.max(dt, 1 / 480)
		local lockTorque = math.clamp(syncTorque, -biasCap, biasCap)
		return half - lockTorque, half + lockTorque
	end

	if self.type == "LIMITED" or self.type == "TORSEN" or self.type == "CLUTCH_LSD" then
		local underPower = inputTorque >= 0
		local lockFraction = underPower and self.powerLock or self.coastLock
		local speedTerm = math.clamp(omegaDiff * 6, -1, 1)
		local biasTorque = (math.abs(inputTorque) * lockFraction + self.preload) * speedTerm
		biasTorque = math.clamp(biasTorque, -biasCap, biasCap)
		return half - biasTorque, half + biasTorque
	end

	return half, half
end

--==========================================================================--
-- WHEEL SIM
--
-- Per-wheel rotational dynamics: torque in from the drivetrain, torque out
-- to the tire (reaction), rolling resistance, and braking, integrated
-- through wheel inertia. This is what makes wheel spin a genuine physical
-- quantity instead of a value derived from chassis speed.
--
-- STABILITY: the tire's grip curve is very stiff near zero slip (a typical
-- loaded tire's stiffness is on the order of 10^5 N per unit slip ratio),
-- while wheel inertia is small (~1 kg*m^2). Explicit Euler integration of
-- that combination is only stable for a timestep on the order of
-- inertia/stiffness -- far smaller than even a substepped Roblox frame --
-- and diverges (with alternating sign, i.e. the wheel-speed oscillation
-- this replaces) the moment dt exceeds that limit. This uses the same
-- technique as ClutchSim/DifferentialSim above: a local linearization of
-- the tire force around the current operating point, solved implicitly
-- (backward Euler). It does not change the tire model itself, only how the
-- wheel's own rotational integration responds to it, and is unconditionally
-- stable regardless of dt or how stiff the tire curve momentarily is.
--==========================================================================--

local WheelSim = {}
WheelSim.__index = WheelSim

function WheelSim.new(config)
	local self = setmetatable({}, WheelSim)
	self.inertia = config.inertia or 1.1 -- kg*m^2 (wheel + tire + brake rotor, real value)
	self.radius = config.radius or 0.32 -- meters
	self.rollingResistanceCoefficient = config.rollingResistanceCoefficient or 0.015
	self.omega = 0
	return self
end

-- driveTorque: Nm delivered from the drivetrain (0 for a non-driven wheel)
-- brakeTorque: Nm of braking capacity currently requested (always opposes current spin direction)
-- tireForceNewtons: this frame's longitudinal tire force at the contact patch (real Newtons),
--     evaluated at the wheel's CURRENT surface speed (the linearization point)
-- tireStiffness: local d(Fx)/d(surfaceSpeedStuds) at that same point, in Newtons per stud/s
--     (returned by FrictionSim.Update alongside the force) -- used only to build the implicit
--     correction below, never applied as a separate force
-- normalLoadNewtons: real Newtons of vertical load at this wheel (for rolling resistance)
-- grounded: whether the wheel is currently touching the ground
function WheelSim:Update(dt, driveTorque, brakeTorque, tireForceNewtons, tireStiffness, normalLoadNewtons, grounded)
	dt = math.max(dt, 1 / 480)

	local reactionTorqueAtCurrentOmega = grounded and (tireForceNewtons * self.radius) or 0

	local reactionDampingNmPerOmega = 0
	if grounded and tireStiffness and tireStiffness > 0 then
		-- Chain rule through surfaceSpeedStuds = omega * radius * MetersToStuds, then one more
		-- factor of radius to go from force to torque: d(reactionTorque)/domega.
		local dForceDOmega = tireStiffness * self.radius * Units.MetersToStuds
		reactionDampingNmPerOmega = dForceDOmega * self.radius
	end

	local rollingResistanceTorque = 0
	if grounded and math.abs(self.omega) > 0.01 then
		local sign = self.omega > 0 and 1 or -1
		rollingResistanceTorque = self.rollingResistanceCoefficient * normalLoadNewtons * self.radius * sign
	end

	local brakeReaction = 0
	if brakeTorque and brakeTorque > 0.01 and math.abs(self.omega) > 0.001 then
		local sign = self.omega > 0 and 1 or -1
		local maxBrakeThisFrame = math.abs(self.omega) * self.inertia / dt
		brakeReaction = -sign * math.min(brakeTorque, maxBrakeThisFrame)
	end

	-- Everything EXCEPT the tire reaction's rate-of-change is explicit (none of the rest is stiff
	-- enough to need this treatment); folding that one term's linearized slope into the
	-- denominator instead of the numerator is what makes this an implicit solve for omega.
	local netOtherTorque = (driveTorque or 0) - reactionTorqueAtCurrentOmega - rollingResistanceTorque + brakeReaction
	local denom = self.inertia / dt + reactionDampingNmPerOmega
	self.omega += netOtherTorque / denom

	return self.omega
end

function WheelSim:GetSurfaceSpeed()
	return self.omega * self.radius -- m/s
end

function WheelSim:GetRPM()
	return Units.RadPerSecToRPM(self.omega)
end

--==========================================================================--
-- AERO
--==========================================================================--

local function computeAeroDragNewtons(speedMps, aero)
	-- F = 0.5 * rho * Cd * A * v^2 (SI). Sign matches direction of travel; caller applies -velocity.Unit.
	return 0.5 * aero.rho * aero.Cd * aero.area * speedMps * math.abs(speedMps)
end

--==========================================================================--
-- TIRE SIM (suspension + contact patch geometry -- unchanged from the
-- original except that FrictionSim now reads wheel speed from WheelSim
-- instead of a shared axle attribute, and normal load is taken from the
-- actual per-wheel suspension force instead of a flat quarter-mass split).
--==========================================================================--

local TireSim = {}

local SAMPLE_RADII = { 0.1, 0.2, 0.3, 0.4 }
local DIAGONAL = math.sqrt(0.5)
local SAMPLE_OFFSETS = {}

for _, radius in ipairs(SAMPLE_RADII) do
	table.insert(SAMPLE_OFFSETS, { radius, 0 })
	table.insert(SAMPLE_OFFSETS, { -radius, 0 })
	table.insert(SAMPLE_OFFSETS, { 0, radius })
	table.insert(SAMPLE_OFFSETS, { 0, -radius })
end

for _, radius in ipairs(SAMPLE_RADII) do
	local diagonal = radius * DIAGONAL
	table.insert(SAMPLE_OFFSETS, { diagonal, diagonal })
	table.insert(SAMPLE_OFFSETS, { diagonal, -diagonal })
	table.insert(SAMPLE_OFFSETS, { -diagonal, diagonal })
	table.insert(SAMPLE_OFFSETS, { -diagonal, -diagonal })
end

local function getContactPoint(tire, origin, rayLength, raycastParams)
	local cframe = tire.CFrame
	local right = cframe.RightVector
	local forward = cframe.LookVector
	local direction = -cframe.UpVector * rayLength

	local hitPoints = {}
	local normals = {}
	local materialCounts = {}
	local hitCount = 0

	local function cast(rayOrigin)
		local result = workspace:Raycast(rayOrigin, direction, raycastParams)
		if result then
			hitCount += 1
			hitPoints[hitCount] = result.Position
			normals[hitCount] = result.Normal
			materialCounts[result.Material] = (materialCounts[result.Material] or 0) + 1
		end
	end

	cast(origin)
	for _, offset in ipairs(SAMPLE_OFFSETS) do
		cast(origin + right * offset[1] + forward * offset[2])
	end

	if hitCount == 0 then
		return nil
	end

	local highestY = -math.huge
	for i = 1, hitCount do
		highestY = math.max(highestY, hitPoints[i].Y)
	end

	local positionSum = Vector3.zero
	local normalSum = Vector3.zero
	local keptCount = 0

	for i = 1, hitCount do
		if highestY - hitPoints[i].Y <= 0.05 then
			positionSum += hitPoints[i]
			normalSum += normals[i]
			keptCount += 1
		end
	end

	local averageNormal = if normalSum.Magnitude > 1e-6 then normalSum.Unit else Vector3.yAxis

	local commonMaterial
	local highestCount = 0
	for material, count in pairs(materialCounts) do
		if count > highestCount then
			commonMaterial = material
			highestCount = count
		end
	end

	return positionSum / keptCount, averageNormal, commonMaterial
end

function TireSim.Update(car, wheel, raycastParams)
	local springStrength = car:GetAttribute("psi") * 300
	local damper = car:GetAttribute("damper")
	local tireStart = car:GetAttribute("tirestart")
	local tireEnd = car:GetAttribute("tireend")
	local contactRadius = tireEnd + 0.35 - tireStart

	local tire = wheel.Bounds
	local up = tire.CFrame.UpVector

	local startPosition = tire.Position - up * tireStart
	tire.TIRESTART.WorldPosition = startPosition
	tire.TIREEND.WorldPosition = tire.Position - up * tireEnd

	local tireForce = tire.TireForce
	local frictionForce = tire.FrictionForce

	local contactPosition, groundNormal, groundMaterial = getContactPoint(tire, startPosition, contactRadius, raycastParams)

	if not contactPosition then
		tireForce.Force = Vector3.zero
		frictionForce.Force = Vector3.zero
		return nil
	end

	tire.ForceAtt.WorldPosition = contactPosition

	local suspensionLength = startPosition.Y - contactPosition.Y
	local compression = suspensionLength - contactRadius

	local springForce = -springStrength * compression
	local damperForce = -damper * tire.AssemblyLinearVelocity.Y

	local normalForce = springForce + damperForce
	tireForce.Force = groundNormal * normalForce

	return {
		folder = wheel,
		tire = tire,
		CPos = contactPosition,
		car = car,
		grM = groundMaterial,
		normalLoadRoblox = math.max(normalForce, 0), -- Roblox-unit vertical load, used as the grip budget
	}
end

--==========================================================================--
-- FRICTION SIM (Pacejka-like brush model -- unchanged core math from the
-- original; only the surface-speed source changed, from a shared axle
-- attribute to this wheel's own WheelSim angular velocity).
--==========================================================================--

local FrictionSim = {}

local MU_LOOKUP = {
	[Enum.Material.Asphalt] = 1.9, [Enum.Material.Concrete] = 1.9, [Enum.Material.Pavement] = 1.1,
	[Enum.Material.Grass] = 0.7, [Enum.Material.Mud] = 0.25, [Enum.Material.Sand] = 0.4,
	[Enum.Material.Snow] = 0.2, [Enum.Material.Ice] = 0.08, [Enum.Material.Ground] = 1.0,
	[Enum.Material.Rock] = 0.9, [Enum.Material.Salt] = 0.7, [Enum.Material.Basalt] = 0.95,
	[Enum.Material.LeafyGrass] = 0.35, [Enum.Material.CrackedLava] = 0.15, [Enum.Material.Glacier] = 0.1,
	[Enum.Material.Plastic] = 0.7, [Enum.Material.SmoothPlastic] = 0.6, [Enum.Material.Granite] = 0.95,
	[Enum.Material.Slate] = 0.9, [Enum.Material.Wood] = 0.6, [Enum.Material.WoodPlanks] = 0.65,
	[Enum.Material.CorrodedMetal] = 0.9, [Enum.Material.DiamondPlate] = 1.0, [Enum.Material.Metal] = 0.65,
	[Enum.Material.Foil] = 0.15, [Enum.Material.Marble] = 0.45, [Enum.Material.Glass] = 0.05,
	[Enum.Material.Pebble] = 0.5, [Enum.Material.Fabric] = 0.7, [Enum.Material.Neon] = 0.3,
	[Enum.Material.ForceField] = 0.0,
}

local LONGITUDINAL = { B = 10.0, C = 1.65, E = 0.97, maxSlip = 1.0 }
local LATERAL = { B = 6.5, C = 1.30, E = 1.00, maxSlip = math.rad(18) }

local LOW_SPEED_REFERENCE = 2.5
local STATIONARY_THRESHOLD = 0.75
local STATIC_DAMPING = 220
local SLIP_SMOKE_START = 0.35

local function pacejkaNormalized(slip, params)
	local clampedSlip = math.clamp(slip, -params.maxSlip, params.maxSlip)
	local bx = params.B * clampedSlip
	return math.sin(params.C * math.atan(bx - params.E * (bx - math.atan(bx))))
end

-- surfaceSpeedStuds: this wheel's own rotational surface speed (studs/s), from WheelSim, converted by the caller.
-- Returns the longitudinal tire force in REAL NEWTONS (not Roblox force units) plus telemetry, so the caller can
-- both apply it to Roblox (converted) and feed it back into WheelSim (already real Newtons, no conversion needed).
function FrictionSim.Update(tireInfo, surfaceSpeedStuds)
	local tire = tireInfo.tire
	local car = tireInfo.car
	local folder = tireInfo.folder
	local contactPosition = tireInfo.CPos
	local groundMaterial = tireInfo.grM

	local forwardDir = tire.CFrame.LookVector
	forwardDir = Vector3.new(forwardDir.X, 0, forwardDir.Z).Unit
	local rightDir = tire.CFrame.RightVector
	rightDir = Vector3.new(rightDir.X, 0, rightDir.Z).Unit

	-- Convert this wheel's share of the Roblox-unit suspension load into real Newtons for grip math.
	local verticalLoadNewtons = Units.RobloxForceToNewtons(tireInfo.normalLoadRoblox)
	local roadMu = MU_LOOKUP[groundMaterial] or 0.6

	local contactOffset = contactPosition - tire.Position
	local velocityAtContact = tire.AssemblyLinearVelocity + tire.AssemblyAngularVelocity:Cross(contactOffset)
	local longitudinalVelStuds = velocityAtContact:Dot(forwardDir)
	local lateralVelStuds = velocityAtContact:Dot(rightDir)

	local referenceSpeed = math.max(math.abs(longitudinalVelStuds), math.abs(surfaceSpeedStuds), LOW_SPEED_REFERENCE)

	local slipRatio = (surfaceSpeedStuds - longitudinalVelStuds) / referenceSpeed
	local slipAngle = math.atan2(lateralVelStuds, math.max(math.abs(longitudinalVelStuds), LOW_SPEED_REFERENCE))

	slipRatio = math.clamp(slipRatio, -LONGITUDINAL.maxSlip, LONGITUDINAL.maxSlip)
	slipAngle = math.clamp(slipAngle, -LATERAL.maxSlip, LATERAL.maxSlip)

	local isStationary = math.abs(longitudinalVelStuds) < STATIONARY_THRESHOLD
		and math.abs(surfaceSpeedStuds) < STATIONARY_THRESHOLD
		and math.abs(lateralVelStuds) < STATIONARY_THRESHOLD

	local FxMax = verticalLoadNewtons * roadMu
	local FyMax = verticalLoadNewtons * roadMu

	if FxMax <= 0 or FyMax <= 0 then
		tire.FrictionForce.Force = Vector3.zero
		return 0, 0, 0
	end

	local frictionForceNewtons

	if isStationary then
		local driveSlip = math.clamp(surfaceSpeedStuds / LOW_SPEED_REFERENCE, -1, 1)
		local driveFx = pacejkaNormalized(driveSlip, LONGITUDINAL) * FxMax
		local holdFx = -longitudinalVelStuds * roadMu * STATIC_DAMPING
		local holdFy = -lateralVelStuds * roadMu * STATIC_DAMPING
		frictionForceNewtons = forwardDir * (driveFx + holdFx) + rightDir * holdFy
	else
		local Fx = pacejkaNormalized(slipRatio, LONGITUDINAL) * FxMax
		local Fy = pacejkaNormalized(slipAngle, LATERAL) * FyMax

		local ellipse = math.sqrt((Fx / FxMax) ^ 2 + (Fy / FyMax) ^ 2)
		if ellipse > 1 then
			Fx /= ellipse
			Fy /= ellipse
		end

		frictionForceNewtons = forwardDir * Fx - rightDir * Fy
	end

	-- Apply to Roblox in Roblox force units; keep the plain forward-axis Newton magnitude for WheelSim feedback.
	tire.FrictionForce.Force = frictionForceNewtons * Units.ForceScale

	local normalizedSlipAngle = math.abs(slipAngle) / LATERAL.maxSlip
	local totalSlip = math.sqrt(slipRatio * slipRatio + normalizedSlipAngle * normalizedSlipAngle)

	local forceAttachment = tire:FindFirstChild("ForceAtt")
	if forceAttachment then
		local smoke = forceAttachment:FindFirstChild("TireSmoke")
		local skid = forceAttachment:FindFirstChild("Skid")
		local slipping = totalSlip > SLIP_SMOKE_START and tire.AssemblyLinearVelocity.Magnitude > 1.0

		if smoke then
			smoke.Rate = if slipping then 50 * math.min(totalSlip, 2) else 0
		end
		if skid then
			skid.Volume = if slipping then 0.5 * totalSlip else 0
			skid.PlaybackSpeed = if slipping then 0.85 + 0.4 * totalSlip else 0
		end
	end

	car:SetAttribute(folder.Name .. "totalSlip", totalSlip)

	-- Local tangent stiffness of the Pacejka curve at the current operating point (Newtons per
	-- stud/s of wheel surface speed), for WheelSim's implicit integration -- NOT an extra force.
	local stiffnessReference = if isStationary then LOW_SPEED_REFERENCE else referenceSpeed
	local longitudinalStiffness = FxMax * (LONGITUDINAL.B * LONGITUDINAL.C) / math.max(stiffnessReference, 0.01)

	local forwardForceNewtons = frictionForceNewtons:Dot(forwardDir)
	return forwardForceNewtons, verticalLoadNewtons, longitudinalStiffness
end

local RenameTable = {
	["ForceAtt"] = { "ForceAtt_2", "ForceAtt_3", "ForceAtt_4" },
	["SteerSlide"] = { "SteerSlide_2" },
	["TIREEND"] = { "TIREEND_2", "TIREEND_3", "TIREEND_4" },
	["TIRESTART"] = { "TIRESTART_2", "TIRESTART_3", "TIRESTART_4" },
	["SpinAtt"] = { "SpinAtt_2", "SpinAtt_3", "SpinAtt_4" },
}

local function RenameClones(parent)
	for originalName, clones in pairs(RenameTable) do
		for _, cloneName in ipairs(clones) do
			local child = parent:FindFirstChild(cloneName, true)
			if child then
				child.Name = originalName
			end
		end
	end
end

local function resolveCar(car)
	for _, name in ipairs(REQUIRED_CHILDREN) do
		if not car:FindFirstChild(name) then
			warn(string.format("UnifiedCarHandler: %s is missing '%s'", car:GetFullName(), name))
			return nil
		end
	end

	for _, name in ipairs(REQUIRED_ATTRIBUTES) do
		if typeof(car:GetAttribute(name)) ~= "number" then
			warn(string.format("UnifiedCarHandler: %s is missing numeric attribute '%s'", car:GetFullName(), name))
			return nil
		end
	end

	RenameClones(car)

	local mass = car.Mass
	local primary = car.Primary

	if not (mass:IsA("BasePart") and primary:IsA("BasePart")) then
		warn(string.format("UnifiedCarHandler: %s has Mass or Primary of the wrong type", car:GetFullName()))
		return nil
	end

	local driverMass = car:FindFirstChild("DriverMass")
	if driverMass and not driverMass:IsA("BasePart") then
		driverMass = nil
	end

	local drag = mass:FindFirstChild("Drag")
	if drag and not drag:IsA("VectorForce") then
		drag = nil
	end

	local steerSlide = primary:FindFirstChild("SteerSlide")
	if steerSlide and not steerSlide:IsA("Attachment") then
		steerSlide = nil
	end

	return {
		wheels = car.Wheels,
		mass = mass,
		primary = primary,
		throttleValue = car.Throttle,
		brakeValue = car.Brake,
		clutchValue = car.Clutch,
		steerValue = car.Steer,
		driverMass = driverMass,
		drag = drag,
		steerSlide = steerSlide,
	}
end

local function setCollisionsEnabled(targetCharacter, enabled, cache)
	if not targetCharacter then
		return
	end

	if enabled then
		for part, originalValue in pairs(cache) do
			if part.Parent then
				part.CanCollide = originalValue
			end
		end
		table.clear(cache)
	else
		for _, part in ipairs(targetCharacter:GetDescendants()) do
			if part:IsA("BasePart") then
				cache[part] = part.CanCollide
				part.CanCollide = false
			end
		end
	end
end

local function findLimbJoint(character, limbName)
	local torso = character:FindFirstChild("Torso")
	if not torso then
		return nil
	end
	for _, joint in ipairs(torso:GetChildren()) do
		if joint:IsA("Motor6D") and joint.Part1 and joint.Part1.Name == limbName then
			return joint
		end
	end
	return nil
end

local function findRootJoint(character)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	for _, joint in ipairs(hrp:GetChildren()) do
		if joint:IsA("Motor6D") then
			return joint
		end
	end
	return nil
end

