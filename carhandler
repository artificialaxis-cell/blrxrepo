function UnifiedCarHandler:HandleCar(car)
	if typeof(car) ~= "Instance" or not car:IsA("Model") then
		warn("UnifiedCarHandler:HandleCar expects a car Model")
		return
	end

	if handledCars[car] then
		return
	end

	local player = Players.LocalPlayer
	if not player then
		warn("UnifiedCarHandler:HandleCar must be called from a client script")
		return
	end
	print("Resolving car")
	local parts = resolveCar(car)
	if not parts then
		return
	end

	handledCars[car] = true

	local wheels = parts.wheels
	local stats = parts.stats
	local mass = parts.mass
	local primary = parts.primary
	local throttleValue = parts.throttleValue
	local brakeValue = parts.brakeValue
	local clutchValue = parts.clutchValue
	local steerValue = parts.steerValue
	local driverMass = parts.driverMass
	local drag = parts.drag
	local steerSlide = parts.steerSlide

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = { car }

	local alive = true
	local driving = false
	local gear = 0
	local engineRPM = 0
	local mouseSteer = false
	local enteredAt = 0
	local entryCFrame = mass.CFrame

	local character
	local humanoid
	local rootPart
