local LONGITUDINAL = {
	B = 10.0,
	C = 1.65,
	E = 0.97,
	maxSlip = 1.0,
}

local LATERAL = {
	B = 6.5,
	C = 1.30,
	E = 1.00,
	maxSlip = math.rad(18),
}

local LOW_SPEED_REFERENCE = 2.5
local STATIONARY_THRESHOLD = 0.75
local STATIC_DAMPING = 220
local SLIP_SMOKE_START = 0.35

local function pacejkaNormalized(slip, params)
	local clampedSlip = math.clamp(slip, -params.maxSlip, params.maxSlip)
	local bx = params.B * clampedSlip

	return math.sin(params.C * math.atan(bx - params.E * (bx - math.atan(bx))))
end

local function getSurfaceSpeed(tireInfo)
	local car = tireInfo.car
	local folder = tireInfo.folder

	local axleSpeed
	if folder.Name == "FR" or folder.Name == "FL" then
		axleSpeed = car:GetAttribute("frontWS")
	else
		axleSpeed = car:GetAttribute("rearWS")
	end

	if typeof(axleSpeed) == "number" then
		return axleSpeed
	end

	local tire = tireInfo.tire
	local radius = tire:GetAttribute("Radius") or tire.Size.Y * 0.5
	local wheelOmega = tire.AssemblyAngularVelocity:Dot(tire.CFrame.RightVector)

	if math.abs(wheelOmega) > 1e-3 then
		return wheelOmega * radius
	end

	return 0
end

function FrictionSimulation.Update(tireInfo)
	local tire = tireInfo.tire
	local car = tireInfo.car
	local folder = tireInfo.folder
	local contactPosition = tireInfo.CPos
	local groundMaterial = tireInfo.grM

	local forwardDir = tire.CFrame.LookVector
	local rightDir = tire.CFrame.RightVector

	local verticalLoad = (car.Mass.AssemblyMass * workspace.Gravity) / 4
	local roadMu = MU_LOOKUP[groundMaterial] or 0.6
	local surfaceSpeed = getSurfaceSpeed(tireInfo)

	local contactOffset = contactPosition - tire.Position
	local velocityAtContact = tire.AssemblyLinearVelocity + tire.AssemblyAngularVelocity:Cross(contactOffset)
	local longitudinalVel = velocityAtContact:Dot(forwardDir)
	local lateralVel = velocityAtContact:Dot(rightDir)

	local referenceSpeed = math.max(math.abs(longitudinalVel), math.abs(surfaceSpeed), LOW_SPEED_REFERENCE)

	local slipRatio = (surfaceSpeed - longitudinalVel) / referenceSpeed
	local slipAngle = math.atan2(lateralVel, math.max(math.abs(longitudinalVel), LOW_SPEED_REFERENCE))

	slipRatio = math.clamp(slipRatio, -LONGITUDINAL.maxSlip, LONGITUDINAL.maxSlip)
	slipAngle = math.clamp(slipAngle, -LATERAL.maxSlip, LATERAL.maxSlip)

	local isStationary = math.abs(longitudinalVel) < STATIONARY_THRESHOLD
		and math.abs(surfaceSpeed) < STATIONARY_THRESHOLD
		and math.abs(lateralVel) < STATIONARY_THRESHOLD

	local FxMax = verticalLoad * roadMu
	local FyMax = verticalLoad * roadMu

	if FxMax <= 0 or FyMax <= 0 then
		return
	end

	local frictionForce

	if isStationary then
		local driveSlip = math.clamp(surfaceSpeed / LOW_SPEED_REFERENCE, -1, 1)
		local driveFx = pacejkaNormalized(driveSlip, LONGITUDINAL) * FxMax

		local holdFx = -longitudinalVel * roadMu * STATIC_DAMPING
		local holdFy = -lateralVel * roadMu * STATIC_DAMPING

		frictionForce = forwardDir * (driveFx + holdFx) + rightDir * holdFy
	else
		local Fx = pacejkaNormalized(slipRatio, LONGITUDINAL) * FxMax
		local Fy = pacejkaNormalized(slipAngle, LATERAL) * FyMax

		local ellipse = math.sqrt((Fx / FxMax) ^ 2 + (Fy / FyMax) ^ 2)
		if ellipse > 1 then
			Fx /= ellipse
			Fy /= ellipse
		end

		frictionForce = forwardDir * Fx - rightDir * Fy
	end

	tire.FrictionForce.Force = frictionForce

	local normalizedSlipAngle = math.abs(slipAngle) / LATERAL.maxSlip
	local totalSlip = math.sqrt(slipRatio * slipRatio + normalizedSlipAngle * normalizedSlipAngle)

	local forceAttachment = tire:FindFirstChild("ForceAtt")
	if forceAttachment then
		local smoke = forceAttachment:FindFirstChild("TireSmoke")
		local skid = forceAttachment:FindFirstChild("Skid")
		local slipping = totalSlip > SLIP_SMOKE_START and tire.AssemblyLinearVelocity.Magnitude > 1.0

		if smoke then
			smoke.Rate = if slipping then 50 * math.min(totalSlip, 2) else 0
		end

		if skid then
			skid.Volume = if slipping then 0.5 * totalSlip else 0
			skid.PlaybackSpeed = if slipping then 0.85 + 0.4 * totalSlip else 0
		end
	end

	car:SetAttribute(folder.Name .. "totalSlip", totalSlip)
end

