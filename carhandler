local function RenameClones(parent)
	for originalName, clones in pairs(RenameTable) do
		for _, cloneName in ipairs(clones) do
			local child = parent:FindFirstChild(cloneName,true)
			if child then
				child.Name = originalName
			end
		end
	end
end

local function resolveCar(car)
	for _, name in ipairs(REQUIRED_CHILDREN) do
		if not car:FindFirstChild(name) then
			warn(string.format("UnifiedCarHandler: %s is missing '%s'", car:GetFullName(), name))
			return nil
		end
	end

	for _, name in ipairs(REQUIRED_ATTRIBUTES) do
		if typeof(car:GetAttribute(name)) ~= "number" then
			warn(string.format("UnifiedCarHandler: %s is missing numeric attribute '%s'", car:GetFullName(), name))
			return nil
		end
	end
	
	RenameClones(car)

	local mass = car.Mass
	local primary = car.Primary

	if not (mass:IsA("BasePart") and primary:IsA("BasePart")) then
		warn(string.format("UnifiedCarHandler: %s has Mass, Primary or Stats of the wrong type", car:GetFullName()))
		return nil
	end

	local driverMass = car:FindFirstChild("DriverMass")
	if driverMass and not driverMass:IsA("BasePart") then
		driverMass = nil
	end

	local drag = mass:FindFirstChild("Drag")
	if drag and not drag:IsA("VectorForce") then
		drag = nil
	end

	local steerSlide = primary:FindFirstChild("SteerSlide")
	if steerSlide and not steerSlide:IsA("Attachment") then
		steerSlide = nil
	end

	return {
		wheels = car.Wheels,
		stats = stat,
		mass = mass,
		primary = primary,
		throttleValue = car.Throttle,
		brakeValue = car.Brake,
		clutchValue = car.Clutch,
		steerValue = car.Steer,
		driverMass = driverMass,
		drag = drag,
		steerSlide = steerSlide,
	}
end

local function flatten(vector, fallback)
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 0.01 then
		return fallback
	end

	return flat.Unit
end

local function approach(current, target, speed, dt)
	if current < target then
		return math.min(current + speed * dt, target)
	end

	if current > target then
		return math.max(current - speed * dt, target)
	end

	return current
end

local handledCars = setmetatable({}, { __mode = "k" })

local UnifiedCarHandler = {}

function UnifiedCarHandler:HandleCar(car)
	if typeof(car) ~= "Instance" or not car:IsA("Model") then
		warn("UnifiedCarHandler:HandleCar expects a car Model")
		return
	end

	if handledCars[car] then
		return
	end

	local player = Players.LocalPlayer
	if not player then
		warn("UnifiedCarHandler:HandleCar must be called from a client script")
		return
	end
	print("Resolving car")
	local parts = resolveCar(car)
	if not parts then
		return
	end

	handledCars[car] = true

	local wheels = parts.wheels
	local stats = parts.stats
	local mass = parts.mass
	local primary = parts.primary
	local throttleValue = parts.throttleValue
	local brakeValue = parts.brakeValue
	local clutchValue = parts.clutchValue
	local steerValue = parts.steerValue
	local driverMass = parts.driverMass
	local drag = parts.drag
	local steerSlide = parts.steerSlide

	local cameraController = createCameraController(car)

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = { car }

	local alive = true
	local driving = false
	local gear = 0
	local mouseSteer = false
	local enteredAt = 0
	local entryCFrame = mass.CFrame

	local character
	local humanoid
	local rootPart
	local diedConnection

	local connections = {}
	local activeTweens = {}

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EnterCarPrompt"
	prompt.ActionText = CONFIG.PromptActionText
	prompt.ObjectText = car.Name
	prompt.KeyboardKeyCode = CONFIG.EnterKey
	prompt.GamepadKeyCode = CONFIG.EnterGamepadKey
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = CONFIG.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = driverMass or mass
	print("resolved, going stats")

	stat = {
		throttle_response_time = 0.18,   -- turbo spooling but rally-tuned
		brake_response_time = 0.35,      -- strong rally brakes, no full carbon race lag
		clutch_response_time = 0.08,     -- sequential-style fast shifts
		steer_response_time_active = 2.4,
		steer_response_time_inactive = 1.1,

		wheel_radius = car:GetAttribute("tireend"),
		maxsteer = 48,                   -- rally steering angle
		ackerman = true,
		antiacker = false,

		maxWheelTorque = 1450,           -- AWD traction split reduces per-wheel spike

		engine = {
			cylinders = 4,
			idlerpm = 850,
			redline = 7500,
			air_fuel_ratio = 11.8,        -- turbo-rich rally tune
			volumetric_efficiency = 0.92,
			friction_loss = 0.14,
			inertia = 2.4,

			torqueCurve = {
				[1000] = 280,
				[1500] = 380,
				[2500] = 520,
				[3500] = 620,
				[4500] = 650,
				[5500] = 620,
				[6500] = 560,
				[7200] = 480
			},

			maxtorque = 650,              -- Nm (rally spec tuned 3S-GTE range)
			rpmbounce = {min = 200, max = 800},

			basestartupchance = 7,
			startupinterval = 0.22,
			maxhold = 4,
			chancegrowth = 12,
		},

		mass = car.Mass:GetMass(), -- ~1300–1400kg in practice

		transmission = {
			-- 5-speed close ratio rally gearbox
			gears = { -3.20, 0, 3.30, 2.28, 1.72, 1.30, 1.05 },
			final_drive = 4.10,
			shift_time = 0.11,
			eff = 0.92,
			type = "AWD",
			difftype = "LOCK",   -- rally center diff behavior

			wheelinertia = 0.55,

			shiftratiochange = {
				[1] = 0.42,
				[2] = 0.50,
				[3] = 0.60,
				[4] = 0.72,
				[5] = 0.85
			},
		},

		aero = {
			rho = 1.225,
			Cd = 0.32,                    -- rally body + wing drag
			area = 2.25,
			rolling_resistance = 0.6
		},
	}

	local function track(connection)
		table.insert(connections, connection)
		return connection
	end

	local function tweenValue(value, target, duration)
		local previous = activeTweens[value]
		if previous then
			previous:Cancel()
		end

		local tween = TweenService:Create(value, TweenInfo.new(duration), { Value = target })
		activeTweens[value] = tween
		tween:Play()
	end

	local function releaseControls(parked)
		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		throttleValue.Value = 0
		clutchValue.Value = 0
		brakeValue.Value = if parked then 1 else 0
	end

	local function computeExitCFrame()
		if not (car:IsDescendantOf(workspace) and mass:IsDescendantOf(car)) then
			return entryCFrame
		end

		local massCFrame = mass.CFrame

		local side = -1
		if driverMass then
			side = if massCFrame:PointToObjectSpace(driverMass.Position).X < 0 then -1 else 1
		end

		local halfWidth = car:GetExtentsSize().X * 0.5
		local rightVector = flatten(massCFrame.RightVector, Vector3.xAxis)
		local lookVector = flatten(massCFrame.LookVector, -Vector3.zAxis)

		local position = massCFrame.Position
			+ rightVector * side * (halfWidth + CONFIG.ExitSideClearance)
			+ Vector3.yAxis * CONFIG.ExitHeight

		return CFrame.lookAt(position, position + lookVector)
	end

	local function leaveCar()
		if not driving then
			return
		end
		driving = false

		local exitCFrame = computeExitCFrame()

		releaseControls(true)

		if diedConnection then
			diedConnection:Disconnect()
			diedConnection = nil
		end

		local subject = if humanoid and humanoid.Parent then humanoid else nil
		cameraController:Disable(subject)

		if rootPart and rootPart.Parent then
			rootPart.Anchored = false
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
			rootPart.CFrame = exitCFrame
		end

		character = nil
		humanoid = nil
		rootPart = nil

		if alive and prompt.Parent then
			prompt.Enabled = true
		end
	end

	local function hideCharacter(root)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = CONFIG.HiddenCFrame

		task.delay(CONFIG.HideAnchorDelay, function()
			if driving and rootPart == root and root.Parent then
				root.Anchored = true
			end
		end)
	end

	local function enterCar()
		if driving or not alive then
			return
		end

		local currentCharacter = player.Character
		local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
		local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")

		if not currentHumanoid or not currentRoot or currentHumanoid.Health <= 0 then
			return
		end

		driving = true
		enteredAt = os.clock()
		character = currentCharacter
		humanoid = currentHumanoid
		rootPart = currentRoot
		entryCFrame = currentRoot.CFrame

		prompt.Enabled = false
		releaseControls(false)

		hideCharacter(currentRoot)
		cameraController:Enable()

		diedConnection = currentHumanoid.Died:Connect(leaveCar)
	end

	local function shiftGear(direction)
		if clutchValue.Value <= 0.67 then
			return
		end

		task.wait(stats.transmission.shift_time)

		if not alive or not driving then
			return
		end

		local newGear = gear + direction
		if newGear > -2 and newGear < #stats.transmission.gears - 1 then
			gear = newGear
		end
	end

	local function isCarIntact()
		return car:IsDescendantOf(workspace) and mass.Parent ~= nil and primary.Parent ~= nil
	end

	local function destroy()
		if not alive then
			return
		end

		if driving then
			leaveCar()
		end

		alive = false

		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)

		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		cameraController:Disable(nil)

		prompt:Destroy()
		handledCars[car] = nil
	end

	local function step(dt)
		if not isCarIntact() then
			destroy()
			return
		end

		if driving then
			cameraController:Update(dt)
		end

		local frameScale = dt * 60

		local steerTime = stats.steer_response_time_inactive
		local targetSteer = 0
		local mouseControlled = false

		if driving and not UserInputService:GetFocusedTextBox() then
			if mouseSteer then
				local viewportWidth = math.max(workspace.CurrentCamera.ViewportSize.X, 1)
				steerValue.Value = math.clamp((UserInputService:GetMouseLocation().X / viewportWidth) * 2 - 1, -1, 1)
				mouseControlled = true
			else
				local left = UserInputService:IsKeyDown(CONFIG.SteerLeftKey)
				local right = UserInputService:IsKeyDown(CONFIG.SteerRightKey)

				if left ~= right then
					targetSteer = if left then -1 else 1
					steerTime = stats.steer_response_time_active
				end
			end
		end

		if not mouseControlled then
			steerValue.Value = approach(steerValue.Value, targetSteer, steerTime, dt)
		end

		if steerSlide then
			steerSlide.Position = Vector3.new(steerValue.Value * -0.31, -1.17, -7.216)
		end

		local velocity = mass.AssemblyLinearVelocity
		local carSpeed = mass.CFrame:VectorToObjectSpace(velocity)
		local carSpeedFront = carSpeed.Z

		if drag then
			local aero = stats.aero
			local dragForce = Vector3.zero

			if aero and velocity.Magnitude > 0.01 then
				local magnitude = 7.5 * aero.rho * aero.Cd * aero.area * carSpeedFront * carSpeedFront
				dragForce = -velocity.Unit * Vector3.new(1, 0.5, 1) * magnitude
			end

			drag.Force = dragForce
		end

		local throttle = throttleValue.Value
		local brake = brakeValue.Value
		local clutch = clutchValue.Value

		local wheelSpeed = (((throttle * 50) * gear) * (1 - clutch))
			+ -carSpeedFront * ((1 - throttle) * 1 - clutch) * (1 - brake)

		for _, attribute in WHEEL_SPEED_ATTRIBUTES do
			car:SetAttribute(attribute, wheelSpeed)
		end
		car:SetAttribute("rearWS", wheelSpeed)
		car:SetAttribute("frontWS", wheelSpeed)

		local tireEnd = car:GetAttribute("tireend")

		for _, wheel in ipairs(wheels:GetChildren()) do
			local speedAttribute = WHEEL_SPEED_ATTRIBUTES[wheel.Name]

			if speedAttribute then
				local tireInfo = TireSimulation.Update(car, wheel, raycastParams)
				if tireInfo then
					FrictionSimulation.Update(tireInfo)
				end

				local roll = wheel.Roll
				roll.Value = (roll.Value + car:GetAttribute(speedAttribute) / tireEnd * frameScale) % 360

				wheel.Bounds.SpinAtt.CFrame = CFrame.fromOrientation(math.rad(-roll.Value), 0, 0)
			end
		end
	end

	track(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not driving then
			return
		end

		local key = input.KeyCode

		if key == CONFIG.ThrottleKey then
			tweenValue(throttleValue, 1, stats.throttle_response_time)
		elseif key == CONFIG.BrakeKey then
			tweenValue(brakeValue, 1, stats.brake_response_time)
		elseif key == CONFIG.ClutchKey then
			tweenValue(clutchValue, 1, stats.clutch_response_time)
		elseif key == CONFIG.GearUpKey then
			if os.clock() - enteredAt > CONFIG.EnterInputGuard then
				shiftGear(1)
			end
		elseif key == CONFIG.GearDownKey then
			shiftGear(-1)
		elseif key == CONFIG.CameraKey then
			cameraController:ChangeState()
		elseif key == CONFIG.MouseSteerKey then
			mouseSteer = not mouseSteer
		elseif key == CONFIG.ExitKey then
			leaveCar()
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if not driving then
			return
		end

		local key = input.KeyCode

		if key == CONFIG.ThrottleKey then
			tweenValue(throttleValue, 0, stats.throttle_response_time / 2)
		elseif key == CONFIG.BrakeKey then
			tweenValue(brakeValue, 0, stats.brake_response_time / 2)
		elseif key == CONFIG.ClutchKey then
			tweenValue(clutchValue, 0, stats.clutch_response_time / 2)
		end
	end))

	track(prompt.Triggered:Connect(enterCar))

	track(player.CharacterRemoving:Connect(function()
		if driving then
			leaveCar()
		end
	end))

	track(car.AncestryChanged:Connect(function()
		if not car:IsDescendantOf(workspace) then
			destroy()
		end
	end))

	track(car.Destroying:Connect(destroy))

	task.delay(CONFIG.StartDelay, function()
		if not alive then
			return
		end

		mass.Anchored = false
		releaseControls(true)
		prompt.Enabled = true

		track(RunService.RenderStepped:Connect(step))
	end)
end

return UnifiedCarHandler
