function TireSim.Update(car, wheel, raycastParams)
	local springStrength = car:GetAttribute("psi") * 300
	local damper = car:GetAttribute("damper")
	local tireStart = car:GetAttribute("tirestart")
	local tireEnd = car:GetAttribute("tireend")
	local contactRadius = tireEnd + 0.35 - tireStart

	local tire = wheel.Bounds
	local up = tire.CFrame.UpVector

	local startPosition = tire.Position - up * tireStart
	tire.TIRESTART.WorldPosition = startPosition
	tire.TIREEND.WorldPosition = tire.Position - up * tireEnd

	local tireForce = tire.TireForce
	local frictionForce = tire.FrictionForce

	local contactPosition, groundNormal, groundMaterial = getContactPoint(tire, startPosition, contactRadius, raycastParams)

	if not contactPosition then
		tireForce.Force = Vector3.zero
		frictionForce.Force = Vector3.zero
		return nil
	end

	tire.ForceAtt.WorldPosition = contactPosition

	local suspensionLength = startPosition.Y - contactPosition.Y
	local compression = suspensionLength - contactRadius

	local springForce = -springStrength * compression
	local damperForce = -damper * tire.AssemblyLinearVelocity.Y

	tireForce.Force = groundNormal * (springForce + damperForce)

	return {
		folder = wheel,
		tire = tire,
		CPos = contactPosition,
		car = car,
		grM = groundMaterial,
	}
end

